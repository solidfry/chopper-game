/* Options overlay, terminal style. Colours, fonts and control styles come from the shared theme (ChopperTheme.uss). */

/* Full-screen layer: darkens and blurs the game behind the menu. */
.options {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  background-color: rgba(4, 13, 5, 0.75);
  backdrop-filter: blur(6px);
}

.options--hidden {
  display: none;
}

/* The terminal window: near-black, square, thin green frame with a title bar. */
.options__panel {
  width: 680px;
  background-color: var(--chopper-terminal);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green);
  border-radius: 0;
}

.options__bar {
  flex-direction: row;
  justify-content: space-between;
  padding: 4px 12px;
  background-color: var(--chopper-green-faint);
  border-bottom-width: 1px;
  border-color: var(--chopper-green-dim);
}

.options__bar-text {
  font-size: 11px;
  color: var(--chopper-green);
  padding: 0;
  opacity: 0.8;
}

.options__body {
  padding: 18px 28px 22px 28px;
}

.options__title {
  font-size: 26px;
  color: var(--chopper-green);
  margin-bottom: 8px;
  -unity-text-align: middle-left;
  padding: 0;
}

.options__section {
  font-size: 12px;
  color: var(--chopper-yellow);
  margin-top: 16px;
  margin-bottom: 4px;
  padding: 0 0 4px 0;
  border-bottom-width: 1px;
  border-color: var(--chopper-green-faint);
}

.options__row {
  margin: 5px 0;
}

.options__row > .unity-label {
  min-width: 280px;
  font-size: 13px;
}

.options__row .unity-base-popup-field__text,
.options__row .unity-base-dropdown__label {
  font-size: 13px;
}

/* Button: a bracketed command line. */
.options__button {
  margin: 22px 0 0 0;
  height: 40px;
  font-size: 16px;
  color: var(--chopper-green);
  background-color: rgba(0, 0, 0, 0.4);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

.options__button:hover,
.options__button:focus {
  background-color: var(--chopper-green-faint);
  border-color: var(--chopper-green);
  color: var(--chopper-text);
}

/* Second command under RESUME: less weight, same style. */
.options__button--secondary {
  margin-top: 8px;
  height: 34px;
  font-size: 13px;
}

.options__button--hidden {
  display: none;
}
