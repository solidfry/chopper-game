/* Shared cyberpunk theme: colours, fonts and the terminal look of the standard controls.
   Screens add their own layout USS.
   Palette: the style guide in Figma (GuildMaster file, "Section 1"). Six accents, each with a dark pair for fills.
   Cards in the guide: dark fill + 1px accent border + accent text. Roles: Console Green = UI and friendly,
   Dream Cyan = team A and info, Lightning Yellow = team B, score and caution, Screamer Red = danger and damage,
   Cruise Pink = boost and highlights, Electric Blue = brand accent. Use these tokens; do not add new colours.
   Fonts: Karnivore (Assets/Fonts/Karnivore, Apostrophic Lab) for headings and UI elements: Lite by default (labels,
   values, buttons, tiles), Bold for titles and alerts (class chopper-title). Longer text (descriptions, sentences)
   uses Chakra Petch Regular (Assets/Fonts/ChakraPetch, OFL), class chopper-body, in sentence case: Karnivore is hard
   to read in long runs and at small sizes (its K looks like H). Two display cuts for small decoration only (serials, index numbers, readouts that carry no
   information the player needs): chopper-deco-dot (Karnivore Digit, dot matrix) and chopper-deco-seven (Karnivore
   Seven, segments). Never on titles, buttons, values, states or anything the player must read to play.
   Controls are restyled here (not per screen) because a dropdown's list opens at the panel root,
   outside the screen that owns it. */
:root {
  --palette-console-green: #00ff94;
  --palette-console-green-dark: #081b0a;
  --palette-dream-cyan: #00f0ff;
  --palette-dream-cyan-dark: #1c2829;
  --palette-lightning-yellow: #ffdf6b;
  --palette-lightning-yellow-dark: #292721;
  --palette-screamer-red: #ff4246;
  --palette-screamer-red-dark: #2a1a1a;
  --palette-cruise-pink: #ff4289;
  --palette-cruise-pink-dark: #251a24;
  --palette-electric-blue: #4200ff;
  --palette-electric-blue-dark: #070019;

  /* Roles. The -dim/-faint values are the accent at 35% / 12% (USS cannot add alpha to a variable). */
  --chopper-green: var(--palette-console-green);
  --chopper-green-dim: rgba(0, 255, 148, 0.35);
  --chopper-green-faint: rgba(0, 255, 148, 0.12);
  --chopper-green-dark: var(--palette-console-green-dark);
  --chopper-cyan: var(--palette-dream-cyan);
  --chopper-cyan-dark: var(--palette-dream-cyan-dark);
  --chopper-yellow: var(--palette-lightning-yellow);
  --chopper-yellow-dark: var(--palette-lightning-yellow-dark);
  --chopper-red: var(--palette-screamer-red);
  --chopper-red-dark: var(--palette-screamer-red-dark);
  --chopper-pink: var(--palette-cruise-pink);
  --chopper-pink-dark: var(--palette-cruise-pink-dark);
  --chopper-blue: var(--palette-electric-blue);
  --chopper-blue-dark: var(--palette-electric-blue-dark);
  --chopper-panel: rgba(8, 27, 10, 0.72);
  --chopper-terminal: rgba(8, 27, 10, 0.94);
  --chopper-text: #d8ffe9;

  --chopper-border-width: 1px;
  --chopper-radius: 0;

  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOL.ttf");
  /* Karnivore sets tight: extra letter spacing everywhere (chopper-body resets it for Chakra Petch). */
  letter-spacing: 1px;
  color: var(--chopper-text);
}

/* Karnivore sets tight: extra letter spacing (px; large titles add more in their screen's USS). */
.chopper-title {
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOB.ttf");
  letter-spacing: 2px;
}

/* Longer text: descriptions and sentences (see the header). */
.chopper-body {
  -unity-font: url("/Assets/Fonts/ChakraPetch/ChakraPetch-Regular.ttf");
  font-size: 13px;
  letter-spacing: 0;
}

/* Decoration only (see the header): small, dim, never information the player needs. */
.chopper-deco-dot {
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOD.ttf");
  font-size: 10px;
  color: var(--chopper-green);
  opacity: 0.45;
  padding: 0;
}

.chopper-deco-seven {
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVSV.ttf");
  font-size: 11px;
  color: var(--chopper-green);
  opacity: 0.5;
  padding: 0;
}

/* ---- Terminal controls ---- */

/* Field labels: dim green, like terminal prompts. */
.unity-base-field__label {
  color: var(--chopper-green);
  opacity: 0.85;
}

/* Dropdown and text field: one terminal box. Every state is set here, so none falls back to the default theme (its
   :active state is a light grey box, its hover text is pure white: both unreadable on our green).

   State       | Box                                        | Text
   ------------|--------------------------------------------|----------------
   rest        | black 50 %, dim green border               | green
   hover       | faint green fill, green border, 3px bar    | bright (text)
   focus       | same as hover                              | bright
   active      | same as hover (pressed, or the list open)  | bright
   disabled    | rest look at 40 % opacity                  | green

   The accent bar is a 3px left border; the left padding drops by 2px, so the text does not move. Selectors carry the
   field's own state (:hover:enabled ... on the field), so they win over the default theme's. */
.unity-base-popup-field > .unity-base-popup-field__input,
.unity-base-text-field > .unity-base-text-field__input {
  background-color: rgba(0, 0, 0, 0.5);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
  color: var(--chopper-green);
  margin: 0;
  padding: 2px 8px 2px 10px;
  height: 24px;
  --unity-cursor-color: var(--chopper-green);
  --unity-selection-color: rgba(0, 255, 148, 0.35);
}

.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input,
.unity-base-popup-field:focus:enabled > .unity-base-popup-field__input,
.unity-base-popup-field:active:enabled > .unity-base-popup-field__input,
.unity-base-popup-field:checked:enabled > .unity-base-popup-field__input,
.unity-base-text-field:hover:enabled > .unity-base-text-field__input,
.unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.unity-base-text-field:active:enabled > .unity-base-text-field__input {
  border-color: var(--chopper-green);
  border-left-width: 3px;
  padding-left: 8px;
  background-color: var(--chopper-green-faint);
  color: var(--chopper-text);
}

.unity-base-popup-field:disabled > .unity-base-popup-field__input,
.unity-base-text-field:disabled > .unity-base-text-field__input {
  opacity: 0.4;
}

.unity-base-popup-field__text {
  color: var(--chopper-green);
}

.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input > .unity-base-popup-field__text,
.unity-base-popup-field:focus:enabled > .unity-base-popup-field__input > .unity-base-popup-field__text,
.unity-base-popup-field:active:enabled > .unity-base-popup-field__input > .unity-base-popup-field__text,
.unity-base-popup-field:checked:enabled > .unity-base-popup-field__input > .unity-base-popup-field__text {
  color: var(--chopper-text);
}

.unity-base-popup-field__arrow {
  -unity-background-image-tint-color: var(--chopper-green);
}

.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input > .unity-base-popup-field__arrow,
.unity-base-popup-field:focus:enabled > .unity-base-popup-field__input > .unity-base-popup-field__arrow,
.unity-base-popup-field:active:enabled > .unity-base-popup-field__input > .unity-base-popup-field__arrow,
.unity-base-popup-field:checked:enabled > .unity-base-popup-field__input > .unity-base-popup-field__arrow {
  -unity-background-image-tint-color: var(--chopper-text);
}

/* The open list (drawn at the panel root). */
.unity-base-dropdown__container-inner {
  background-color: var(--chopper-terminal);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green);
  border-radius: 0;
}

/* List rows, same language as the field:
   State           | Row                                  | Label
   ----------------|--------------------------------------|----------------------
   rest            | clear, transparent 3px bar           | text at 80 %
   hover / focus   | faint green fill, green bar          | bright (text), 100 %
   active (press)  | same as hover                        | bright
   checked (picked)| clear                                | green, check mark
   checked + hover | faint fill, green bar                | green
   Labels sit in an item-content element: the selectors go through it, so they win over the default theme. */
.unity-base-dropdown__item {
  color: var(--chopper-text);
  background-color: rgba(0, 0, 0, 0);
  border-left-width: 3px;
  border-color: rgba(0, 0, 0, 0);
  padding: 3px 8px 3px 4px;
}

.unity-base-dropdown__item:hover:enabled,
.unity-base-dropdown__item:focus:enabled,
.unity-base-dropdown__item:active:enabled {
  background-color: var(--chopper-green-faint);
  border-color: var(--chopper-green);
}

.unity-base-dropdown__item:checked:enabled {
  background-color: rgba(0, 0, 0, 0);
}

.unity-base-dropdown__item:checked:hover:enabled {
  background-color: var(--chopper-green-faint);
}

.unity-base-dropdown__item > .unity-base-dropdown__item-content > .unity-base-dropdown__label {
  color: var(--chopper-text);
  opacity: 0.8;
}

.unity-base-dropdown__item:hover:enabled > .unity-base-dropdown__item-content > .unity-base-dropdown__label,
.unity-base-dropdown__item:focus:enabled > .unity-base-dropdown__item-content > .unity-base-dropdown__label,
.unity-base-dropdown__item:active:enabled > .unity-base-dropdown__item-content > .unity-base-dropdown__label {
  color: var(--chopper-text);
  opacity: 1;
}

.unity-base-dropdown__item:checked:enabled > .unity-base-dropdown__item-content > .unity-base-dropdown__label,
.unity-base-dropdown__item:checked:hover:enabled > .unity-base-dropdown__item-content > .unity-base-dropdown__label {
  color: var(--chopper-green);
  opacity: 1;
}

.unity-base-dropdown__checkmark {
  -unity-background-image-tint-color: var(--chopper-green);
}

/* Slider: a thin line with a square cursor. Selectors as specific as the default theme's, so these win. */
.unity-base-slider--horizontal .unity-base-slider__tracker,
.unity-base-slider:hover .unity-base-slider__tracker,
.unity-base-slider:focus .unity-base-slider__tracker {
  background-color: var(--chopper-green-dim);
  background-image: none;
  border-width: 0;
  border-radius: 0;
  height: 2px;
  margin-top: -1px;
}

.unity-base-slider--horizontal .unity-base-slider__dragger,
.unity-base-slider:hover .unity-base-slider__dragger,
.unity-base-slider:active .unity-base-slider__dragger,
.unity-base-slider:focus .unity-base-slider__dragger {
  background-color: var(--chopper-green);
  background-image: none;
  border-width: 0;
  border-radius: 0;
  width: 8px;
  height: 16px;
  margin-top: -8px;
}

.unity-base-slider__dragger-border {
  display: none;
}

/* Focused field: brighter green, not the default blue. */
.unity-base-field:focus > .unity-base-field__label,
.unity-base-field:focus:enabled > .unity-base-field__label,
.unity-base-field:hover > .unity-base-field__label,
.unity-base-field:hover:enabled > .unity-base-field__label {
  color: var(--chopper-text);
  opacity: 1;
}

/* Toggle: an empty box, filled green when on. */
.unity-toggle__checkmark {
  background-color: rgba(0, 0, 0, 0.5);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
  -unity-background-image-tint-color: var(--chopper-green);
}

.unity-toggle:hover .unity-toggle__checkmark {
  border-color: var(--chopper-green);
}


/* ---- Window open / close (WindowTransition.cs): a CRT screen that powers on and off ----
   Open: --off (a dark point) -> --line (a bright line across the middle, 0.12 s) -> open (0.2 s, a small overshoot).
   Close: --closing --line (falls in to the line, 0.13 s) -> --off (the line shrinks to the middle, 0.12 s) -> hidden.
   The beam is a green layer over the window: bright while it is a line, it fades as the window opens. */
.chopper-window {
  transition-property: scale, opacity;
  transition-duration: 0.2s, 0.12s;
  transition-timing-function: ease-out-back, linear;
}

.chopper-window--line {
  scale: 1 0.004;
  transition-duration: 0.12s, 0.12s;
  transition-timing-function: ease-out-cubic, linear;
}

.chopper-window--off {
  scale: 0 0.004;
  opacity: 0;
}

.chopper-window--closing {
  transition-duration: 0.13s, 0.12s;
  transition-timing-function: ease-in-cubic, ease-in-cubic;
}

.chopper-window--snap {
  transition-duration: 0s, 0s;
}

.chopper-window__beam {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(190, 255, 225);
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.25s;
  transition-timing-function: ease-out-cubic;
}

.chopper-window--line > .chopper-window__beam,
.chopper-window--off > .chopper-window__beam {
  opacity: 1;
  transition-duration: 0.06s;
}

/* ---- Scroll bars (every ScrollView): a thin terminal rail ----
   A 2px dim track line and a 4px solid green thumb. The size never changes; hover and drag only light the thumb up.
   Selectors start at the ScrollView and name the scroller's direction, so they beat the default theme in every state
   (at rest it draws a thin white bar; on hover it widens the thumb). */
.unity-scroll-view .unity-scroller--vertical {
  width: 10px;
  min-width: 10px;
  margin-left: 6px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view .unity-scroller--horizontal {
  height: 10px;
  min-height: 10px;
  margin-top: 6px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view .unity-scroller .unity-scroller__low-button,
.unity-scroll-view .unity-scroller .unity-scroller__high-button {
  display: none;
}

.unity-scroll-view .unity-scroller .unity-scroller__slider {
  flex-grow: 1;
  margin: 0;
  padding: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-scroller__slider,
.unity-scroll-view .unity-scroller--vertical:hover .unity-scroller__slider {
  width: 10px;
  min-width: 10px;
}

.unity-scroll-view .unity-scroller--horizontal .unity-scroller__slider,
.unity-scroll-view .unity-scroller--horizontal:hover .unity-scroller__slider {
  height: 10px;
  min-height: 10px;
}

.unity-scroll-view .unity-scroller .unity-base-slider__tracker,
.unity-scroll-view .unity-scroller:hover .unity-base-slider__tracker {
  background-color: var(--chopper-green-faint);
  background-image: none;
  border-width: 0;
  border-radius: 0;
  margin: 0;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__tracker,
.unity-scroll-view .unity-scroller--vertical:hover .unity-base-slider__tracker {
  position: absolute;
  width: 2px;
  left: 4px;
  right: auto;
  top: 0;
  bottom: 0;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__tracker,
.unity-scroll-view .unity-scroller--horizontal:hover .unity-base-slider__tracker {
  position: absolute;
  height: 2px;
  top: 4px;
  bottom: auto;
  left: 0;
  right: 0;
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller:hover .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller .unity-base-slider__dragger:hover,
.unity-scroll-view .unity-scroller .unity-base-slider__dragger:active {
  background-color: var(--chopper-green);
  background-image: none;
  border-width: 0;
  border-radius: 0;
  opacity: 0.45;
  transition-property: opacity;
  transition-duration: 0.12s;
}

.unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller--vertical:hover .unity-base-slider__dragger {
  width: 4px;
  left: 3px;
  margin: 0;
}

.unity-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller--horizontal:hover .unity-base-slider__dragger {
  height: 4px;
  top: 3px;
  margin: 0;
}

.unity-scroll-view .unity-scroller:hover .unity-base-slider__dragger,
.unity-scroll-view .unity-scroller .unity-base-slider__dragger:active {
  opacity: 1;
}

.unity-scroll-view .unity-scroller .unity-base-slider__dragger-border {
  display: none;
}

/* ---- Other built-in controls, so none shows the default grey look ----
   Selectors are as strong as the default theme's (no extra :enabled), so a screen's own classes still win. */

/* Button with no screen class: the terminal button (dim box, green text; green fill on hover). */
.unity-button {
  background-color: rgba(0, 0, 0, 0.5);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
  color: var(--chopper-green);
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOB.ttf");
  letter-spacing: 2px;
  padding: 4px 14px;
}

.unity-button:hover,
.unity-button:focus {
  background-color: var(--chopper-green);
  border-color: var(--chopper-green);
  color: var(--chopper-green-dark);
}

.unity-button:active {
  background-color: var(--chopper-text);
  color: var(--chopper-green-dark);
}

.unity-button:disabled {
  opacity: 0.4;
}

/* Toggle on: the box fills faint green with a green border. */
.unity-toggle:checked .unity-toggle__checkmark {
  background-color: var(--chopper-green-faint);
  border-color: var(--chopper-green);
}

/* Toggle button group (segmented choice). */
.unity-toggle-button-group .unity-button:checked {
  background-color: var(--chopper-green);
  color: var(--chopper-green-dark);
  border-color: var(--chopper-green);
}

/* Radio button: a square, like the toggle. */
.unity-radio-button__checkmark-background {
  background-color: rgba(0, 0, 0, 0.5);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

.unity-radio-button:hover .unity-radio-button__checkmark-background {
  border-color: var(--chopper-green);
}

.unity-radio-button__checkmark {
  background-color: var(--chopper-green);
  border-radius: 0;
  -unity-background-image-tint-color: var(--chopper-green);
}

/* Progress bar: a dim track and a green fill, the title in text colour. */
.unity-progress-bar__background {
  background-color: rgba(0, 0, 0, 0.5);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

.unity-progress-bar__progress {
  background-color: var(--chopper-green);
  border-radius: 0;
}

.unity-progress-bar__title {
  color: var(--chopper-text);
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOB.ttf");
  font-size: 12px;
}

/* Min-max slider: the range in green between two square thumbs. */
.unity-min-max-slider__tracker {
  background-color: var(--chopper-green-dim);
  border-width: 0;
  border-radius: 0;
  height: 2px;
}

.unity-min-max-slider__dragger {
  background-color: var(--chopper-green-faint);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green);
  border-radius: 0;
}

.unity-min-max-slider__min-thumb,
.unity-min-max-slider__max-thumb {
  background-color: var(--chopper-green);
  border-width: 0;
  border-radius: 0;
}

/* Foldout: a green arrow and title, the content indented under a faint rule. */
.unity-foldout__text {
  color: var(--chopper-green);
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOB.ttf");
  letter-spacing: 2px;
}

.unity-foldout__checkmark {
  -unity-background-image-tint-color: var(--chopper-green);
}

.unity-foldout__toggle:hover .unity-foldout__text {
  color: var(--chopper-text);
}

.unity-foldout__content {
  border-left-width: 1px;
  border-color: var(--chopper-green-faint);
  padding-left: 8px;
}

/* List and tree rows: a faint fill and a green bar for the selection (not the default blue). */
.unity-collection-view__item {
  color: var(--chopper-text);
  background-color: rgba(0, 0, 0, 0);
  border-left-width: 3px;
  border-color: rgba(0, 0, 0, 0);
}

.unity-collection-view__item:hover {
  background-color: var(--chopper-green-faint);
}

.unity-collection-view__item--selected,
.unity-collection-view__item--selected:hover {
  background-color: var(--chopper-green-faint);
  border-color: var(--chopper-green);
  color: var(--chopper-green);
}

.unity-collection-view--with-border {
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

/* Tabs: labels in a row; the open tab green with a line under it (the Figma nav). */
.unity-tab-view__header-container {
  border-bottom-width: 1px;
  border-color: var(--chopper-green-dim);
}

.unity-tab__header {
  background-color: rgba(0, 0, 0, 0);
  border-width: 0;
  border-bottom-width: 2px;
  border-color: rgba(0, 0, 0, 0);
  padding: 6px 14px;
}

.unity-tab__header-label {
  color: var(--chopper-green-dim);
  -unity-font: url("/Assets/Fonts/Karnivore/KARNIVOB.ttf");
  letter-spacing: 3px;
}

.unity-tab__header:hover .unity-tab__header-label {
  color: var(--chopper-text);
}

.unity-tab__header:checked {
  border-color: var(--chopper-green);
}

.unity-tab__header:checked .unity-tab__header-label {
  color: var(--chopper-green);
}

/* Help box: a terminal note. */
.unity-help-box {
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
  color: var(--chopper-text);
}
