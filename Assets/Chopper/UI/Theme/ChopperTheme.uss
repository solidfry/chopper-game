/* Shared green cyberpunk theme. Colours and fonts only; screens add their own layout USS. */
:root {
  --chopper-green: #39ff88;
  --chopper-green-dim: rgba(57, 255, 136, 0.35);
  --chopper-green-faint: rgba(57, 255, 136, 0.12);
  --chopper-amber: #ffb000;
  --chopper-red: #ff3b3b;
  --chopper-panel: rgba(4, 16, 10, 0.72);
  --chopper-text: #d8ffe9;

  --chopper-border-width: 1px;
  --chopper-radius: 2px;

  -unity-font: url("../Fonts/Inconsolata-SemiBold.ttf");
  color: var(--chopper-text);
}
