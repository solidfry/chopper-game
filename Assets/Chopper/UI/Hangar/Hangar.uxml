<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hangar="Chopper.UI.Hangar" editor-extension-mode="False">
  <Style src="Hangar.uss" />
  <!-- Hangar (HangarView), plan section 5 "New layout". Overview: the chopper in the middle with a callout card per
       socket, chassis cards and saved builds on the left, stats floating on the right, slot tiles along the bottom.
       Slot open: "SELECT <SLOT>", the module detail on the left, module tiles along the bottom. Lists and callouts are
       filled from code. The top bar is kept for the main game navigation (later). -->
  <ui:VisualElement name="hangar" class="hangar" picking-mode="Ignore">
    <ui:VisualElement name="callouts" class="hangar__callouts" picking-mode="Ignore">
      <hangar:CalloutLines name="callout-lines" class="hangar__callout-lines" picking-mode="Ignore" />
    </ui:VisualElement>

    <ui:VisualElement class="hangar__bar">
      <ui:Label text="HANGAR//SYS" class="hangar__bar-text chopper-title" />
      <!-- Decoration only (segment readout): no information. -->
      <ui:Label text="0451-K7" class="chopper-deco-seven hangar__bar-deco" picking-mode="Ignore" />
      <ui:VisualElement class="hangar__bar-nav" picking-mode="Ignore" />
      <ui:Label text="{Back} = BACK" class="hangar__bar-text input-prompt" />
    </ui:VisualElement>

    <ui:VisualElement class="hangar__main" picking-mode="Ignore">
      <ui:VisualElement class="hangar__column hangar__column--left" picking-mode="Ignore">
        <ui:VisualElement name="overview-panel" class="hangar__block">
          <ui:Label name="chassis-name" text="CHASSIS" class="hangar__title chopper-title" />
          <ui:Label name="chassis-description" class="hangar__description chopper-body" />
          <ui:Label text="// CHASSIS" class="hangar__section chopper-title" />
          <ui:VisualElement name="chassis-grid" class="hangar__chassis-grid" />
          <ui:Label text="// PILOT" class="hangar__section chopper-title" />
          <!-- The locked-in pilot; click opens the pilot select screen (PilotSelectView) -->
          <ui:Button name="pilot-card" class="hangar-pilot">
            <ui:Label name="pilot-card-mono" class="hangar-pilot__mono chopper-title" picking-mode="Ignore" />
            <ui:VisualElement class="hangar-pilot__text" picking-mode="Ignore">
              <ui:Label name="pilot-card-sign" class="hangar-pilot__sign chopper-title" picking-mode="Ignore" />
              <ui:Label name="pilot-card-role" class="hangar-pilot__role" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="CHANGE &gt;" class="hangar-pilot__change" picking-mode="Ignore" />
          </ui:Button>
          <ui:Label text="// BUILDS" class="hangar__section chopper-title" />
          <ui:DropdownField name="preset" label="BUILD" class="hangar__row" />
          <ui:TextField name="preset-name" label="NAME" max-length="24" class="hangar__row hangar__name-field" />
          <ui:VisualElement class="hangar__preset-buttons">
            <ui:Button name="preset-save" text="SAVE" class="hangar__small-button" />
            <ui:Button name="preset-rename" text="RENAME" class="hangar__small-button" />
            <ui:Button name="preset-delete" text="DELETE" class="hangar__small-button" />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="focus-panel" class="hangar__focus">
          <ui:VisualElement class="hangar__focus-header">
            <ui:Button name="back" text="&lt;" class="hangar__back chopper-title" />
            <ui:Label name="focus-title" text="SELECT" class="hangar__focus-title chopper-title" />
          </ui:VisualElement>
          <ui:VisualElement class="hangar__detail">
            <ui:Label name="detail-name" class="hangar__detail-name chopper-title" />
            <ui:Label name="detail-description" class="hangar__description hangar__detail-description chopper-body" />
            <ui:VisualElement class="hangar__detail-tags">
              <ui:Label name="detail-state" class="hangar__tag" />
              <ui:Label name="detail-weight" class="hangar__tag hangar__tag--plain" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <ui:VisualElement class="hangar__spacer" picking-mode="Ignore" />

      <ui:VisualElement class="hangar__column hangar__column--right" picking-mode="Ignore">
        <ui:VisualElement class="hangar__stats-float" picking-mode="Ignore">
          <ui:VisualElement name="stats-headline" class="hangar__headline" picking-mode="Ignore" />
          <ui:VisualElement name="stats" class="hangar__stats" picking-mode="Ignore" />
          <ui:VisualElement class="hangar-stat" picking-mode="Ignore">
            <ui:Label text="WEIGHT" class="hangar-stat__label" />
            <ui:VisualElement name="weight-track" class="hangar-stat__track">
              <ui:VisualElement name="weight-fill" class="hangar-stat__fill" />
              <ui:VisualElement name="weight-delta" class="hangar-stat__delta" />
            </ui:VisualElement>
            <ui:Label name="weight-text" class="hangar-stat__text" />
          </ui:VisualElement>
          <ui:Label text="// PAINT" class="hangar__section chopper-title" />
          <ui:VisualElement name="skins" class="hangar__skins" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement class="hangar__bottom" picking-mode="Ignore">
      <ui:VisualElement class="hangar__tiles-frame" picking-mode="Ignore">
        <ui:Label name="tiles-title" text="// SLOTS" class="hangar__section chopper-title" />
        <ui:ScrollView name="tiles-scroll" mode="Vertical" class="hangar__tiles-scroll">
          <ui:VisualElement name="tiles" class="hangar__tiles" />
        </ui:ScrollView>
      </ui:VisualElement>
      <ui:VisualElement class="hangar__actions">
        <ui:Label name="error" class="hangar__error" />
        <ui:Label name="match-status" class="hangar__error hangar__match-status" />
        <ui:Button name="find-match" text="[ FIND MATCH ]" class="hangar__button chopper-title" />
        <ui:DropdownField name="training-map" label="MAP" class="hangar__row hangar__map-row" />
        <ui:Button name="launch" text="[ TRAINING ]" class="hangar__button hangar__button--secondary chopper-title" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Pilot select (plan section 5b): fighting-game style. The shown pilot large on the left (call sign slams in),
         the roster grid on the right, LOCK IN at the bottom. Filled by PilotSelectView. -->
    <ui:VisualElement name="pilot-select" class="pilot-select hangar--hidden">
      <ui:VisualElement class="pilot-select__scan" picking-mode="Ignore" />
      <ui:VisualElement class="pilot-select__header" picking-mode="Ignore">
        <ui:Label text="// SELECT PILOT" class="pilot-select__title chopper-title" />
        <ui:Label text="ANY PILOT FLIES ANY CHASSIS" class="pilot-select__hint" />
        <ui:Label text="{Back} = BACK" class="hangar__bar-text input-prompt" />
      </ui:VisualElement>
      <ui:VisualElement class="pilot-select__body" picking-mode="Ignore">
        <ui:VisualElement name="pilot-feature" class="pilot-feature" picking-mode="Ignore">
          <ui:VisualElement name="pilot-portrait" class="pilot-feature__portrait" picking-mode="Ignore">
            <!-- Drawn helmet portrait until there is art (PilotPortrait); hidden when the pilot has a portrait texture -->
            <hangar:PilotPortrait name="pilot-drawn" class="pilot-feature__drawn" />
            <ui:Label name="pilot-monogram" class="pilot-feature__monogram chopper-title" picking-mode="Ignore" />
            <ui:Label name="pilot-serial" class="pilot-feature__serial chopper-deco-dot" picking-mode="Ignore" />
          </ui:VisualElement>
          <ui:VisualElement class="pilot-feature__text" picking-mode="Ignore">
            <ui:Label name="pilot-role" class="pilot-feature__role" />
            <ui:Label name="pilot-callsign" class="pilot-feature__callsign chopper-title" />
            <ui:Label name="pilot-passive" class="pilot-feature__passive chopper-body" />
            <ui:VisualElement name="pilot-effects" class="pilot-feature__effects" picking-mode="Ignore" />
            <ui:VisualElement class="pilot-ability" picking-mode="Ignore">
              <ui:Label text="ABILITY // {Ability}" class="pilot-ability__label input-prompt" />
              <ui:Label name="pilot-ability-name" class="pilot-ability__name chopper-title" />
              <ui:Label name="pilot-ability-text" class="pilot-ability__text chopper-body" />
              <ui:Label name="pilot-ability-meta" text="" class="pilot-ability__soon" />
            </ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pilot-grid" class="pilot-grid" />
      </ui:VisualElement>
      <ui:VisualElement class="pilot-select__footer" picking-mode="Ignore">
        <ui:Label name="pilot-state" class="pilot-select__state" />
        <ui:Button name="pilot-lock" text="[ LOCK IN ]" class="hangar__button pilot-select__lock chopper-title" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
