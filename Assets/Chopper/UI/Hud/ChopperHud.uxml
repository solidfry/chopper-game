<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="ChopperHud.uss" />
  <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
    <!-- Match info stays visible while dead -->
    <ui:VisualElement name="match" class="hud-layer hud-match" picking-mode="Ignore">
      <!-- Your death: red tint on the screen (under everything) and an alert in the centre, until you respawn -->
      <ui:VisualElement name="death-tint" class="hud-death-tint hud-death-tint--hidden" picking-mode="Ignore" />
      <ui:VisualElement class="hud-match__top" picking-mode="Ignore">
        <ui:VisualElement name="match-scores" class="hud-match__scores" picking-mode="Ignore">
          <ui:Label name="local-score" text="0 K / 0 D" class="hud-match__score" />
          <!-- Own pilot call sign (empty without a pilot) -->
          <ui:Label name="local-pilot" text="" class="hud-match__pilot chopper-title" />
          <ui:Label name="leader" text="" class="hud-match__leader" />
        </ui:VisualElement>
        <ui:Label name="timer" text="00:00" class="hud-match__timer" />
        <ui:Label name="kill-feed" text="" class="hud-match__feed" />
      </ui:VisualElement>
      <ui:VisualElement name="death-alert" class="hud-death-alert hud-death-alert--hidden" picking-mode="Ignore">
        <ui:Label name="death-alert-text" text="" class="hud-death-alert__text chopper-title" />
      </ui:VisualElement>
      <ui:Label name="banner" text="" class="hud-match__banner hud-match__banner--hidden chopper-title" />
      <!-- Scoreboard: hold Tab / gamepad View; always shown on the results. Rows are made by ScoreboardView -->
      <ui:VisualElement name="scoreboard" class="hud-scoreboard hud-scoreboard--hidden" picking-mode="Ignore">
        <ui:VisualElement class="hud-scoreboard__head" picking-mode="Ignore">
          <ui:Label name="scoreboard-title" text="FREE FOR ALL" class="hud-scoreboard__title chopper-title" />
          <ui:Label name="scoreboard-timer" text="00:00" class="hud-scoreboard__timer" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-scoreboard__row hud-scoreboard__row--columns" picking-mode="Ignore">
          <ui:Label text="#" class="hud-scoreboard__place" />
          <ui:Label text="PILOT" class="hud-scoreboard__name" />
          <ui:Label text="CHOPPER" class="hud-scoreboard__chassis" />
          <ui:Label text="K" class="hud-scoreboard__number" />
          <ui:Label text="D" class="hud-scoreboard__number" />
        </ui:VisualElement>
        <ui:VisualElement name="scoreboard-rows" class="hud-scoreboard__rows" picking-mode="Ignore" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="chopper" class="hud-layer hud--hidden" picking-mode="Ignore">
      <ui:VisualElement name="bounds-warning" class="hud-warning hud-warning--hidden" picking-mode="Ignore">
        <ui:Label text="RETURN TO COMBAT AREA" class="hud-warning__text chopper-title" />
      </ui:VisualElement>
      <!-- Threats against you: blinking, upper middle -->
      <ui:VisualElement name="threats" class="hud-threats" picking-mode="Ignore">
        <ui:Label name="missile-warning" text="MISSILE" class="hud-threat hud-threat--missile hud-threat--hidden chopper-title" />
        <ui:Label name="lock-warning" text="LOCK WARNING" class="hud-threat hud-threat--lock hud-threat--hidden chopper-title" />
        <!-- Hit by a Blackout (pilot HEX): no locks for a moment -->
        <ui:Label name="jam-warning" text="SYSTEMS JAMMED" class="hud-threat hud-threat--jam hud-threat--hidden chopper-title" />
      </ui:VisualElement>
      <ui:VisualElement name="damage-layer" class="hud-layer hud-damage-layer" picking-mode="Ignore">
        <ui:VisualElement name="damage-ring" class="hud-damage hud-damage--hidden" picking-mode="Ignore">
          <ui:VisualElement class="hud-damage__arc" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="missile-ring" class="hud-damage hud-damage--missile hud-damage--hidden" picking-mode="Ignore">
          <ui:VisualElement class="hud-damage__arc" picking-mode="Ignore" />
        </ui:VisualElement>
      </ui:VisualElement>
      <!-- The pilot: a live portrait (PilotPortraitRig) that breathes, blinks, talks on radio lines and takes the scene light -->
      <ui:VisualElement name="pilot" class="hud-pilot hud-pilot--hidden" picking-mode="Ignore">
        <ui:VisualElement name="pilot-picture" class="hud-pilot__picture" picking-mode="Ignore" />
      </ui:VisualElement>
      <!-- World markers: pooled elements made by WorldMarkerView -->
      <ui:VisualElement name="markers" class="hud-layer" picking-mode="Ignore" />
      <ui:VisualElement name="aim-layer" class="hud-layer" picking-mode="Ignore">
        <!-- Rocket lead: put the reticle here to hit the target -->
        <ui:VisualElement name="lead" class="hud-lead hud-lead--hidden" picking-mode="Ignore">
          <ui:VisualElement class="hud-lead__dot" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- Seeker lock: brackets close in on the target as the lock builds -->
        <ui:VisualElement name="lock" class="hud-lock hud-lock--hidden" picking-mode="Ignore">
          <ui:Label name="lock-label" text="LOCK" class="hud-lock__label" />
        </ui:VisualElement>
        <ui:VisualElement name="aim" class="hud-aim" picking-mode="Ignore">
          <ui:VisualElement class="hud-aim__dot" picking-mode="Ignore" />
          <ui:VisualElement name="hit-marker" class="hud-aim__hit" picking-mode="Ignore" />
        </ui:VisualElement>
      </ui:VisualElement>
      <!-- Flight frame: centred on the view like the old HUD; it sways with turns (see ChopperHudView). -->
      <ui:VisualElement name="frame-layer" class="hud-layer hud-frame-layer" picking-mode="Ignore">
        <ui:VisualElement name="frame" class="hud-frame" picking-mode="Ignore">
          <ui:VisualElement name="left" class="hud-frame__side hud-frame__side--left" picking-mode="Ignore">
            <!-- Optics module: "ZOOM 4x" while zoomed (Z / middle mouse / D-pad down) -->
            <ui:Label name="zoom" text="" class="hud-zoom" />
            <ui:Label name="pylon" text="" class="hud-pylon" />
            <ui:Label name="pylon-ammo" text="" class="hud-pylon-ammo" />
            <!-- Refill bars: they grow to the right edge, shown only while the magazine is not full -->
            <ui:VisualElement name="pylon-reload" class="hud-reload hud-reload--hidden" picking-mode="Ignore">
              <ui:VisualElement name="pylon-reload-fill" class="hud-reload__fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="flares" text="FLARES" class="hud-flares" />
            <!-- Pilot ability (F / D-pad up): ready, on, cooling down -->
            <ui:Label name="ability" text="" class="hud-ability hud-ability--hidden" />
            <ui:VisualElement name="flare-reload" class="hud-reload hud-reload--small hud-reload--hidden" picking-mode="Ignore">
              <ui:VisualElement name="flare-reload-fill" class="hud-reload__fill" picking-mode="Ignore" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement class="hud-frame__centre" picking-mode="Ignore">
          <!-- Same artificial horizon as the cockpit flight page, clipped to the circle. Beside the ring, not in it: each has its own opacity option. -->
          <Chopper.UI.Cockpit.AttitudeIndicator name="attitude" class="hud-attitude" degrees-visible="50" />
          <ui:VisualElement name="ring" class="hud-frame__ring" picking-mode="Ignore">
            <!-- Segmented arcs just outside the ring: boost tank (left, fills upward), hull (right, fills upward), gun heat (bottom, fills left to right) -->
            <Chopper.UI.Hud.ArcGauge name="boost" class="hud-arc hud-boost" start-angle="148" sweep="64" segments="16" thickness="7" />
            <Chopper.UI.Hud.ArcGauge name="hull-arc" class="hud-arc hud-hull-arc" start-angle="32" sweep="-64" segments="16" thickness="7" />
            <Chopper.UI.Hud.ArcGauge name="heat-arc" class="hud-arc hud-heat-arc" start-angle="122" sweep="-64" segments="16" thickness="7" />
            <ui:Label text="BOOST" class="hud-arc__label hud-arc__label--left" />
            <ui:Label name="heat-label" text="GUN" class="hud-heat-label" />
          </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="readouts" class="hud-frame__side hud-frame__side--right" picking-mode="Ignore">
            <ui:Label name="boost-tag" text="&gt;&gt; BOOST" class="hud-boost-tag chopper-title" />
            <ui:VisualElement name="speed" class="hud-readout hud-readout--speed" picking-mode="Ignore">
              <ui:Label text="SPD" class="hud-readout__label" />
              <ui:Label name="speed-value" text="0" class="hud-readout__value" />
              <ui:Label text="KM/H" class="hud-readout__unit" />
            </ui:VisualElement>
            <ui:VisualElement name="altitude" class="hud-readout" picking-mode="Ignore">
              <ui:Label text="ALT" class="hud-readout__label" />
              <ui:Label name="altitude-value" text="0" class="hud-readout__value" />
              <ui:Label text="M" class="hud-readout__unit" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="health" class="hud-readout hud-frame__hull" picking-mode="Ignore">
            <ui:Label text="HULL" class="hud-readout__label" />
            <ui:Label name="health-value" text="0" class="hud-readout__value" />
          </ui:VisualElement>
          <!-- Field repair (hold the repair key): hint when damaged, progress while repairing, lock after damage (the bar fills until it is ready) -->
          <ui:VisualElement name="repair-line" class="hud-repair hud-repair--hidden" picking-mode="Ignore">
            <ui:Label name="repair" text="" class="hud-repair__text" />
            <ui:VisualElement name="repair-bar" class="hud-repair__bar" picking-mode="Ignore" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
