.hud {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
}

/* Flight frame, centre of the view */
.hud-frame-layer {
  align-items: center;
  justify-content: center;
}

.hud-frame {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.hud-frame__centre {
  width: 400px;
  height: 400px;
}

.hud-frame__ring {
  width: 400px;
  height: 400px;
  border-radius: 200px;
  border-width: 1px;
  border-color: var(--chopper-green-faint);
  align-items: center;
  justify-content: center;
}

/* Artificial horizon: pitch ladder, bank scale and aircraft mark, clipped to the ring. No ground fill: the view stays clear. */
.hud-attitude {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 200px;
  overflow: hidden;
  --attitude-line: var(--chopper-green-dim);
  --attitude-ground: rgba(0, 0, 0, 0);
  --attitude-mark: var(--chopper-green);
}

/* Side text stands well out from the ring: the middle of the view stays clear. The gap is the padding. */
.hud-frame__side {
  width: 460px;
}

.hud-frame__side--left {
  align-items: flex-end;
  padding-right: 264px;
}

.hud-frame__side--right {
  align-items: flex-start;
  padding-left: 264px;
  /* Away from the horizon line: on the sphere, the further from it, the more the text tilts. */
  translate: 0 -100px;
}

/* Hull readout: in line with speed and altitude (ring radius 200 + side gap 264) */
.hud-frame__hull {
  position: absolute;
  bottom: 20px;
  left: 50%;
  translate: 464px 0;
  min-width: 170px;
}

/* Field repair line, just above the hull readout */
.hud-repair {
  position: absolute;
  bottom: 86px;
  left: 50%;
  translate: 464px 0;
  padding: 3px 10px 5px 10px;
  border-width: 0;
  transition-property: opacity, translate;
  transition-duration: 0.15s;
}

.hud-repair__text {
  font-size: 14px;
  letter-spacing: 6px;
  padding: 0;
  margin: 0;
  color: var(--chopper-green-dim);
}

.hud-repair--hidden {
  opacity: 0;
  translate: 452px 0;
}

.hud-repair--active {
  background-color: rgba(0, 40, 48, 0.6);
  border-left-width: 2px;
  border-color: var(--chopper-cyan);
}

.hud-repair--active .hud-repair__text {
  color: var(--chopper-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
}

.hud-repair--locked {
  background-color: rgba(48, 40, 0, 0.6);
  border-left-width: 2px;
  border-color: var(--chopper-yellow);
}

.hud-repair--locked .hud-repair__text {
  color: var(--chopper-yellow);
}

/* Lock after damage: fills along the bottom of the line until repair is ready */
.hud-repair__bar {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3px;
  width: 0;
  display: none;
  background-color: var(--chopper-yellow);
}

.hud-repair--locked .hud-repair__bar {
  display: flex;
}

/* While repairing the hull arc and readout run cyan (more specific than the low-health red) */
.hud-arc.hud-hull-arc.hud-arc--repairing {
  --arc-fill: var(--chopper-cyan);
  --arc-track: rgba(0, 240, 255, 0.14);
}

.hud-readout.hud-readout--repairing {
  border-color: var(--chopper-cyan);
}

.hud-readout.hud-readout--repairing .hud-readout__value {
  color: var(--chopper-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
}

.hud--hidden {
  opacity: 0;
}

/* Match info, top of the screen */
.hud-match {
  padding: 32px;
}

/* Scores and kill feed sit in the corners. The sphere look cuts the panel's corners, so ChopperHudView moves them in. */
.hud-match__top {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  align-items: center;
  padding-top: 32px;
}

.hud-match__scores {
  position: absolute;
  left: 32px;
  top: 32px;
  width: 360px;
}

/* Kill / death card, top left: two big numbers with captions on a dark plate */
.hud-kd {
  flex-direction: row;
  align-self: flex-start;
  align-items: stretch;
  background-color: var(--chopper-terminal);
  border-width: 1px;
  border-left-width: 4px;
  border-color: var(--chopper-green);
  margin-bottom: 6px;
}

.hud-kd__stat {
  align-items: center;
  padding: 4px 16px 6px 16px;
  min-width: 78px;
}

.hud-kd__divider {
  width: 1px;
  margin: 8px 0;
  background-color: var(--chopper-green-dim);
}

.hud-kd__value {
  font-size: 36px;
  padding: 0;
  -unity-text-align: middle-center;
}

.hud-kd__caption {
  font-size: 12px;
  letter-spacing: 4px;
  color: var(--chopper-text);
  padding: 0;
  -unity-text-align: middle-center;
}

.hud-kd__stat--kills > .hud-kd__value {
  color: var(--chopper-green);
  text-shadow: 0 0 8px rgba(0, 255, 148, 0.45);
}

.hud-kd__stat--deaths > .hud-kd__value {
  color: var(--chopper-red);
  text-shadow: 0 0 8px rgba(255, 66, 70, 0.45);
}

.hud-match__pilot {
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--chopper-yellow);
  padding: 0;
}

.hud-match__leader {
  font-size: 14px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-match__timer {
  font-size: 32px;
  color: var(--chopper-green);
  padding: 4px 16px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

.hud-match__feed {
  position: absolute;
  right: 32px;
  top: 32px;
  width: 360px;
  font-size: 16px;
  color: var(--chopper-text);
  -unity-text-align: upper-right;
  padding: 0;
}

.hud-match__banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  font-size: 72px;
  color: var(--chopper-green);
  -unity-text-align: middle-center;
  text-shadow: 0 0 12px rgba(0, 255, 148, 0.5);
}

.hud-match__banner--hidden {
  display: none;
}

/* Your death: red tint on the whole screen, and an alert in the centre. The look pass makes low alpha read much stronger: tune by eye. */
.hud-death-tint {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 20, 30, 0.04);
  transition-property: opacity;
  transition-duration: 0.15s;
}

.hud-death-tint--hidden {
  opacity: 0;
}

.hud-death-alert {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
}

.hud-death-alert--hidden {
  display: none;
}

.hud-death-alert__text {
  font-size: 32px;
  letter-spacing: 5px;
  color: var(--chopper-red);
  padding: 6px 22px;
  background-color: rgba(30, 4, 6, 0.85);
  border-width: 2px;
  border-color: var(--chopper-red);
  text-shadow: 0 0 14px rgba(255, 66, 70, 0.8);
  -unity-text-align: middle-center;
}

/* Capture the Nuke countdown (MatchHudModel.NukeTimerText): a small pill under the match timer, out of the
   aim area. Green = our clock, red = a threat; the final countdown is a bit bigger with a coloured frame. */
.hud-nuke-timer {
  position: absolute;
  top: 104px;
  align-self: center;
  font-size: 16px;
  letter-spacing: 3px;
  padding: 2px 12px;
  color: var(--chopper-text);
  background-color: rgba(4, 12, 6, 0.55);
  border-radius: var(--chopper-radius);
  -unity-text-align: middle-center;
}

.hud-nuke-timer--hidden { display: none; }
.hud-nuke-timer--good { color: var(--chopper-green); }
.hud-nuke-timer--alert { color: var(--chopper-red); }

.hud-nuke-timer--final {
  font-size: 22px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.35);
}
.hud-nuke-timer--final.hud-nuke-timer--alert { border-color: var(--chopper-red); }
.hud-nuke-timer--final.hud-nuke-timer--good { border-color: var(--chopper-green); }

/* Capture the Nuke objective line under the reticle (MatchHudModel.ObjectiveText). Tone classes set the colour. */
.hud-objective {
  position: absolute;
  left: 0;
  right: 0;
  /* Top of the screen, under the nuke timer pill (owner, 25 Nov); was 60 % down, under the reticle. */
  top: 140px;
  align-items: center;
  --objective-colour: var(--chopper-text);
}

.hud-objective--hidden {
  display: none;
}

.hud-objective--good { --objective-colour: var(--chopper-green); }
.hud-objective--alert { --objective-colour: var(--chopper-red); }

.hud-objective__text {
  font-size: 20px;
  letter-spacing: 3px;
  color: var(--objective-colour);
  padding: 3px 14px;
  background-color: rgba(4, 12, 6, 0.6);
  -unity-text-align: middle-center;
}

/* A new flash (hooked, armed, defused ...) punches in bigger for a moment. */
.hud-objective--flash .hud-objective__text {
  font-size: 26px;
  border-width: 2px;
  border-color: var(--objective-colour);
}

.hud-objective__bar {
  width: 220px;
  height: 4px;
  margin-top: 4px;
  background-color: rgba(4, 12, 6, 0.7);
}

.hud-objective__bar--hidden {
  visibility: hidden;
}

.hud-objective__fill {
  height: 100%;
  width: 0;
  background-color: var(--objective-colour);
}

/* Countdown under the death message (MatchHudModel.RespawnText) */
.hud-death-alert__respawn {
  margin-top: 10px;
  font-size: 18px;
  letter-spacing: 4px;
  color: var(--chopper-red);
  text-shadow: 0 0 10px rgba(255, 66, 70, 0.7);
  -unity-text-align: middle-center;
}

/* Results: the banner moves up over the scoreboard */
.hud-match--results .hud-match__banner {
  top: 12%;
  font-size: 56px;
}

/* Scoreboard: full screen, hold Tab / gamepad View. One column per team (ScoreboardView). Dark backdrop for contrast. */
.hud-scoreboard {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 7% 6% 6% 6%;
  background-color: rgba(4, 12, 6, 0.9);
  transition-property: opacity, translate;
  transition-duration: 0.12s;
}

/* While the scoreboard shows, the flight HUD (drawn after the match layer) is off, so it does not cover the board */
.hud--scoreboard > #chopper {
  display: none;
}

.hud-scoreboard--hidden {
  opacity: 0;
  translate: 0 -8px;
}

/* Results: room for the banner above the board */
.hud-match--results .hud-scoreboard {
  padding-top: 18%;
}

.hud-scoreboard__head {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 4px 10px 4px;
  margin-bottom: 18px;
  border-bottom-width: 2px;
  border-color: var(--chopper-green);
}

.hud-scoreboard__title {
  font-size: 28px;
  letter-spacing: 5px;
  color: var(--chopper-green);
  padding: 0;
}

.hud-scoreboard__timer {
  font-size: 28px;
  color: var(--chopper-text);
  padding: 0;
}

.hud-scoreboard__columns {
  flex-grow: 1;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
}

.hud-scoreboard__column {
  flex-grow: 1;
  flex-basis: 0;
  max-width: 900px;
  margin: 0 12px;
  background-color: var(--chopper-terminal);
  border-width: 1px;
  border-top-width: 4px;
  border-color: var(--team-colour);
  --team-colour: var(--chopper-green);
}

.hud-scoreboard__column--team1 { --team-colour: var(--chopper-cyan); }
.hud-scoreboard__column--team2 { --team-colour: var(--chopper-yellow); }
.hud-scoreboard__column--team3 { --team-colour: var(--chopper-red); }
.hud-scoreboard__column--team4 { --team-colour: var(--chopper-pink); }
.hud-scoreboard__column--team5 { --team-colour: var(--chopper-green); }
.hud-scoreboard__column--team6 { --team-colour: var(--chopper-cyan); }
.hud-scoreboard__column--team7 { --team-colour: var(--chopper-yellow); }
.hud-scoreboard__column--team8 { --team-colour: var(--chopper-red); }

.hud-scoreboard__team {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  border-bottom-width: 1px;
  border-color: var(--team-colour);
}

.hud-scoreboard__team-name {
  font-size: 26px;
  letter-spacing: 6px;
  color: var(--team-colour);
  padding: 0;
}

.hud-scoreboard__team-score {
  font-size: 40px;
  color: var(--team-colour);
  padding: 0;
  -unity-text-align: middle-right;
}

/* Own team: a brighter frame */
.hud-scoreboard__column--own {
  border-width: 2px;
  border-top-width: 6px;
}

.hud-scoreboard__rows {
}

.hud-scoreboard__row {
  height: 40px;
  flex-direction: row;
  align-items: center;
  padding: 0 16px 0 12px;
  border-left-width: 4px;
  border-color: rgba(0, 0, 0, 0);
}

.hud-scoreboard__row > Label {
  font-size: 20px;
  color: #ffffff;
  padding: 0;
  -unity-text-align: middle-left;
}

.hud-scoreboard__row--columns {
  height: 30px;
  background-color: rgba(0, 0, 0, 0.35);
}

.hud-scoreboard__row--columns > Label {
  font-size: 13px;
  letter-spacing: 3px;
  color: var(--chopper-text);
}

.hud-scoreboard__row--odd {
  background-color: rgba(255, 255, 255, 0.05);
}

/* Own row: pink bar and tint, pink name */
.hud-scoreboard__row--local {
  border-color: var(--chopper-pink);
  background-color: rgba(255, 66, 137, 0.16);
}

.hud-scoreboard__row--local > .hud-scoreboard__name {
  color: var(--chopper-pink);
}

/* The leader's place number */
.hud-scoreboard__row--first .hud-scoreboard__place {
  color: var(--chopper-yellow);
}

.hud-scoreboard__place {
  width: 40px;
}

.hud-scoreboard__name {
  flex-grow: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hud-scoreboard__chassis {
  width: 150px;
}

.hud-scoreboard__row > .hud-scoreboard__chassis {
  color: var(--chopper-text);
  font-size: 16px;
}

.hud-scoreboard__number {
  width: 56px;
}

.hud-scoreboard__row > .hud-scoreboard__number {
  -unity-text-align: middle-right;
}

/* Out of bounds warning, upper middle */
.hud-warning {
  position: absolute;
  left: 0;
  right: 0;
  top: 24%;
  align-items: center;
}

.hud-warning--hidden {
  display: none;
}

.hud-warning__text {
  font-size: 28px;
  color: var(--chopper-red);
  padding: 6px 18px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-red);
  text-shadow: 0 0 8px rgba(255, 66, 70, 0.4);
}

/* Readout panels (speed, altitude, hull) */
/* Readouts: style guide card (dark fill, 1px accent border, accent value) */
.hud-readout {
  flex-direction: row;
  align-items: flex-end;
  min-width: 170px;
  margin-bottom: 10px;
  padding: 4px 12px 4px 10px;
  background-color: rgba(8, 27, 10, 0.6);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
}

.hud-readout__label {
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--chopper-green-dim);
  margin-right: 8px;
  margin-bottom: 6px;
  padding: 0;
}

.hud-readout__value {
  font-size: 32px;
  color: var(--chopper-green);
  -unity-text-align: lower-right;
  flex-grow: 1;
  padding: 0;
  margin: 0;
  /* Neon glow without post-processing */
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

.hud-readout__unit {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-left: 6px;
  margin-bottom: 6px;
  padding: 0;
}

/* Health turns red when low */
.hud-readout--low {
  border-color: var(--chopper-red);
  background-color: rgba(42, 26, 26, 0.7);
}

.hud-readout--low .hud-readout__value {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.35);
}

/* Gun reticle. Left/top are set from code (where the gun points); translate centres it on that point. */
.hud-aim {
  position: absolute;
  width: 28px;
  height: 28px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  border-color: var(--chopper-green-dim);
  border-radius: 14px;
}

.hud-aim--hidden {
  display: none;
}

.hud-aim__dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--chopper-green);
}

/* Hit marker: a diamond around the reticle, shown only on a server hit confirm */
.hud-aim__hit {
  position: absolute;
  width: 34px;
  height: 34px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-text);
  opacity: 0;
}

.hud-aim--hit .hud-aim__hit {
  opacity: 1;
}

.hud-aim--kill .hud-aim__hit {
  opacity: 1;
  border-color: var(--chopper-red);
  scale: 1.4 1.4;
}

/* Damage direction: a ring round the screen centre, rotated from code; the arc points at the attacker */
.hud-damage-layer {
  align-items: center;
  justify-content: center;
}

.hud-damage {
  width: 260px;
  height: 260px;
  align-items: center;
  transition-property: opacity;
  transition-duration: 0.3s;
}

.hud-damage--hidden {
  opacity: 0;
}

.hud-damage__arc {
  width: 90px;
  height: 6px;
  border-radius: 3px;
  background-color: var(--chopper-red);
}

/* Boost tank and hull: segmented arcs just outside the flight ring (ArcGauge). Colours are USS custom properties. */
.hud-arc {
  position: absolute;
  left: -18px;
  top: -18px;
  right: -18px;
  bottom: -18px;
  --arc-fill: rgba(0, 255, 148, 0.9);
  --arc-track: rgba(0, 255, 148, 0.12);
}

/* Not enough to start a boost: yellow (caution) */
.hud-boost {
  --arc-fill: var(--chopper-yellow);
  --arc-track: rgba(255, 223, 107, 0.12);
}

.hud-boost--ready {
  --arc-fill: var(--chopper-cyan);
  --arc-track: rgba(0, 240, 255, 0.12);
}

.hud--boosting .hud-boost {
  --arc-fill: var(--chopper-pink);
  --arc-track: rgba(255, 66, 137, 0.15);
}

/* Own class: the readout's low class also sets a dark background, which filled the arc's whole square. */
.hud-hull-arc.hud-arc--low {
  --arc-fill: var(--chopper-red);
  --arc-track: rgba(255, 66, 70, 0.15);
}

/* Gun heat: bottom arc. Yellow while it heats, red when the gun is locked out. */
.hud-heat-arc {
  --arc-fill: var(--chopper-yellow);
  --arc-track: rgba(255, 223, 107, 0.12);
}

.hud-heat-arc.hud-arc--low {
  --arc-fill: var(--chopper-red);
  --arc-track: rgba(255, 66, 70, 0.15);
}

.hud-heat-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -46px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
  -unity-text-align: middle-center;
  padding: 0;
}

.hud-heat-label--hot {
  font-size: 16px;
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.5);
}

/* No gun, or a gun with no heat limit */
.hud-heat--none {
  display: none;
}

.hud-arc__label {
  position: absolute;
  bottom: 52px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-arc__label--left {
  left: -44px;
}

/* Boost (pink): the flight ring runs hot, the speed readout grows and turns pink, the tag slams in. */
.hud-frame__ring {
  transition-property: border-color, scale;
  transition-duration: 0.15s;
}

.hud--boosting .hud-frame__ring {
  border-color: rgba(255, 66, 137, 0.45);
  scale: 1.04 1.04;
}

.hud-boost-tag {
  font-size: 15px;
  letter-spacing: 4px;
  color: var(--chopper-pink);
  padding: 0 0 4px 2px;
  opacity: 0;
  translate: -24px 0;
  text-shadow: 0 0 8px rgba(255, 66, 137, 0.8);
  transition-property: opacity, translate;
  transition-duration: 0.12s;
  transition-timing-function: ease-out-back;
}

.hud--boosting .hud-boost-tag {
  opacity: 1;
  translate: 0 0;
}

.hud-readout--speed {
  transform-origin: left bottom;
  transition-property: scale, border-color, background-color;
  transition-duration: 0.15s;
  transition-timing-function: ease-out-back;
}

.hud--boosting .hud-readout--speed {
  scale: 1.18 1.18;
  border-color: var(--chopper-pink);
  background-color: rgba(37, 26, 36, 0.7);
}

.hud-readout--speed .hud-readout__value {
  transition-property: color;
  transition-duration: 0.15s;
}

.hud--boosting .hud-readout--speed .hud-readout__value {
  color: var(--chopper-pink);
  text-shadow: 0 0 10px rgba(255, 66, 137, 0.7);
}

/* Seeker lock brackets. Size and position are set from code; yellow while building, red when locked. */
.hud-lock {
  position: absolute;
  translate: -50% -50%;
  border-width: 2px;
  border-color: var(--chopper-yellow);
  align-items: center;
  justify-content: flex-end;
}

.hud-lock--hidden {
  display: none;
}

.hud-lock--locked {
  border-color: var(--chopper-red);
  border-width: 3px;
}

.hud-lock__label {
  position: absolute;
  bottom: -26px;
  font-size: 14px;
  color: var(--chopper-yellow);
  padding: 0;
  opacity: 0;
}

.hud-lock--locked .hud-lock__label {
  color: var(--chopper-red);
  opacity: 1;
}

/* Threat warnings */
.hud-threats {
  position: absolute;
  left: 0;
  right: 0;
  top: 17%;
  align-items: center;
}

.hud-threat {
  font-size: 30px;
  padding: 4px 18px;
  margin-bottom: 6px;
  background-color: var(--chopper-panel);
  border-width: 2px;
  -unity-font-style: bold;
}

.hud-threat--missile {
  color: var(--chopper-red);
  border-color: var(--chopper-red);
  text-shadow: 0 0 10px rgba(255, 66, 70, 0.6);
}

.hud-threat--lock {
  font-size: 22px;
  color: var(--chopper-yellow);
  border-color: var(--chopper-yellow);
}

.hud-threat--hidden {
  display: none;
}

/* Blink: dim on the off beat (toggled from the model) */
.hud-threats--dim .hud-threat {
  opacity: 0.25;
}

.hud-damage--missile .hud-damage__arc {
  width: 140px;
  height: 8px;
  background-color: var(--chopper-red);
}

/* Selected pylon weapon and flares, left of the ring */
.hud-pylon {
  margin-top: 10px;
  font-size: 16px;
  color: var(--chopper-green);
  padding: 0;
  -unity-text-align: middle-right;
}

.hud-pylon--needs-lock {
  color: var(--chopper-yellow);
}

.hud-pylon-ammo {
  font-size: 24px;
  color: var(--chopper-green);
  padding: 0;
  -unity-text-align: middle-right;
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

/* Zoom step of the optics module. Cyan: a view mode, not a weapon state. */
.hud-zoom {
  font-size: 22px;
  color: var(--chopper-cyan);
  padding: 0;
  -unity-text-align: middle-right;
  text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
}

/* Optics fitted but off: the key hint, small and dim. */
.hud-zoom--hint {
  font-size: 16px;
  opacity: 0.55;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.hud-pylon-ammo--empty {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.5);
}

/* Magazine refill. Width of the fill is set from code. Cyan like the boost tank: it is a charge that fills up. */
.hud-reload {
  width: 110px;
  height: 5px;
  margin-top: 3px;
  flex-direction: row;
  justify-content: flex-end;
  background-color: rgba(0, 240, 255, 0.14);
}

.hud-reload--small {
  width: 70px;
  height: 4px;
}

.hud-reload--hidden {
  display: none;
}

.hud-reload__fill {
  height: 100%;
  background-color: var(--chopper-cyan);
}

/* The gap splits the left side: weapon above the horizon line, flares and ability below it (more tilt on the sphere) */
.hud-flares {
  margin-top: 170px;
  font-size: 15px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-flares--ready {
  color: var(--chopper-green);
}

/* World markers (WorldMarkerView). Left/top are set from code; translate centres the marker on that point. */
.hud-marker {
  position: absolute;
  translate: -50% -50%;
  align-items: center;
}

.hud-marker--hidden {
  display: none;
}

.hud-marker__icon {
  width: 14px;
  height: 14px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-red);
}

.hud-marker--ground .hud-marker__icon {
  rotate: 0deg;
  border-color: var(--chopper-yellow);
}

.hud-marker--locked .hud-marker__icon {
  background-color: var(--chopper-red);
}

.hud-marker__distance {
  position: absolute;
  top: 18px;
  font-size: 12px;
  color: var(--chopper-text);
  padding: 0;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.hud-marker__health {
  position: absolute;
  top: -10px;
  width: 30px;
  height: 3px;
  background-color: var(--chopper-green-faint);
}

.hud-marker__health-fill {
  height: 100%;
  background-color: var(--chopper-red);
}

.hud-marker--no-health .hud-marker__health,
.hud-marker--offscreen .hud-marker__health {
  display: none;
}

/* Off screen: an arrow on the screen edge points at the target (rotated from code). */
.hud-marker__arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left-width: 7px;
  border-right-width: 7px;
  border-bottom-width: 12px;
  border-left-color: rgba(0, 0, 0, 0);
  border-right-color: rgba(0, 0, 0, 0);
  border-bottom-color: var(--chopper-red);
  display: none;
}

.hud-marker--offscreen .hud-marker__icon {
  display: none;
}

.hud-marker--offscreen .hud-marker__arrow {
  display: flex;
}

.hud-marker--ground .hud-marker__arrow {
  border-bottom-color: var(--chopper-yellow);
}

/* Team mate (team modes): a light blue ring (cyan is taken by the OVERWATCH ping) */
.hud-marker--ally .hud-marker__icon {
  rotate: 0deg;
  border-radius: 50%;
  border-color: var(--chopper-ally);
}

.hud-marker--ally .hud-marker__arrow {
  border-bottom-color: var(--chopper-ally);
}

/* Capture the Nuke: the nuke (a big pink diamond, its bar = hook / arm / defuse progress) and the base zones. */
.hud-marker--nuke .hud-marker__icon {
  width: 22px;
  height: 22px;
  border-width: 3px;
  border-color: var(--chopper-pink);
  background-color: rgba(255, 60, 170, 0.25);
}

.hud-marker--nuke .hud-marker__arrow {
  border-bottom-color: var(--chopper-pink);
}

.hud-marker--nuke .hud-marker__health {
  top: -16px;
  width: 44px;
  height: 4px;
}

.hud-marker--nuke .hud-marker__health-fill {
  background-color: var(--chopper-pink);
}

.hud-marker--home-base .hud-marker__icon,
.hud-marker--enemy-base .hud-marker__icon {
  rotate: 0deg;
  width: 26px;
  height: 14px;
  border-radius: 0;
}

.hud-marker--home-base .hud-marker__icon {
  border-color: var(--chopper-ally);
}

.hud-marker--home-base .hud-marker__arrow {
  border-bottom-color: var(--chopper-ally);
}

.hud-marker--enemy-base .hud-marker__icon {
  border-color: var(--chopper-red);
}

/* Rocket lead indicator */
.hud-lead {
  position: absolute;
  width: 18px;
  height: 18px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-color: var(--chopper-green);
  border-radius: 9px;
}

/* Free aim (no target near the nose): dim, so it reads as "where the rockets go", not a lead */
.hud-lead--free {
  opacity: 0.45;
}

.hud-lead--hidden {
  display: none;
}

.hud-lead__dot {
  width: 4px;
  height: 4px;
  background-color: var(--chopper-green);
}

/* Gun lead: a small ring in the gun colour, no dot, so it reads apart from the rocket lead. Put the gun reticle on it. */
.hud-gun-lead {
  position: absolute;
  width: 22px;
  height: 22px;
  translate: -50% -50%;
  border-width: 2px;
  border-color: var(--chopper-green);
  border-radius: 11px;
}

.hud-gun-lead--hidden {
  display: none;
}

/* Pilot ability line (under flares): dim while cooling down, bright when ready, pink while on */
.hud-ability {
  font-size: 13px;
  letter-spacing: 3px;
  padding: 2px 8px;
  margin-top: 4px;
  color: var(--chopper-green-dim);
  transition-property: opacity, scale;
  transition-duration: 0.15s;
}

.hud-ability--hidden {
  display: none;
}

.hud-ability--ready {
  color: var(--chopper-yellow);
  border-right-width: 2px;
  border-color: var(--chopper-yellow);
  background-color: rgba(48, 40, 0, 0.5);
}

.hud-ability--active {
  color: var(--chopper-pink);
  border-right-width: 2px;
  border-color: var(--chopper-pink);
  background-color: rgba(60, 10, 30, 0.6);
  text-shadow: 0 0 8px rgba(255, 66, 137, 0.7);
  scale: 1.08 1.08;
}

.hud-threat--jam {
  color: var(--chopper-cyan);
  border-color: var(--chopper-cyan);
}

/* Ping (pilot OVERWATCH): every enemy, cyan */
.hud-marker--pinged .hud-marker__icon {
  background-color: var(--chopper-cyan);
}

.hud-marker--pinged.hud-marker--locked .hud-marker__icon {
  background-color: var(--chopper-red);
}

/* The pilot portrait, low and a little left of centre, under the flight ring (a live render texture, in the UI
   green). The picture fades out at its own bottom edge. */
.hud-pilot {
  position: absolute;
  left: 42%;
  bottom: -48px;
  width: 104px;
  translate: -50% 0;
  align-items: center;
}

.hud-pilot--hidden {
  display: none;
}

.hud-pilot__picture {
  width: 104px;
  height: 156px;
  -unity-background-scale-mode: scale-to-fit;
  border-bottom-width: 1px;
  border-color: var(--chopper-green-faint);
}

/* Call sign under the portrait */
.hud-pilot__name {
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--chopper-yellow);
  padding: 2px 0 0 0;
  margin: 0;
  -unity-text-align: upper-center;
  white-space: nowrap;
}

/* XP popup (Battlefield style), low under the reticle, compact. MatchHudModel.AddXp drives it; the view adds --punch for one
   frame at each award, so it slams in big and settles with an overshoot. Kills (--big) burn hot yellow, support
   awards (assist, repair, evaded) glow cyan. */
.hud-xp {
  position: absolute;
  left: 0;
  right: 0;
  top: 72%;
  align-items: center;
  opacity: 1;
  scale: 1 1;
  translate: 0 0;
  transition-property: scale, opacity, translate;
  transition-duration: 0.32s, 0.25s, 0.4s;
  transition-timing-function: ease-out-back, ease-out, ease-out;
}

.hud-xp--hidden {
  opacity: 0;
  translate: 0 -10px;
}

.hud-xp--punch {
  scale: 1.25 1.25;
  transition-duration: 0s, 0s, 0s;
}

.hud-xp__title {
  font-size: 17px;
  letter-spacing: 4px;
  color: var(--chopper-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.85);
  -unity-text-align: middle-center;
  padding: 1px 12px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-color: rgba(0, 240, 255, 0.55);
  background-color: rgba(0, 18, 22, 0.55);
}

.hud-xp--big .hud-xp__title {
  font-size: 22px;
  color: var(--chopper-yellow);
  text-shadow: 0 0 10px rgba(255, 200, 40, 0.95);
  border-color: rgba(255, 200, 40, 0.7);
  background-color: rgba(30, 20, 0, 0.6);
}

.hud-xp__name {
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--chopper-red);
  text-shadow: 0 0 10px rgba(255, 66, 70, 0.8);
  margin-top: 1px;
  -unity-text-align: middle-center;
}

.hud-xp__total {
  font-size: 20px;
  letter-spacing: 2px;
  color: rgb(255, 255, 255);
  text-shadow: 0 0 8px rgba(0, 255, 150, 0.95);
  margin-top: 2px;
  -unity-text-align: middle-center;
}

.hud-xp--big .hud-xp__total {
  font-size: 26px;
  text-shadow: 0 0 12px rgba(255, 200, 40, 1);
}

.hud-xp__lines {
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--chopper-green);
  text-shadow: 0 0 8px rgba(0, 255, 150, 0.6);
  -unity-text-align: upper-center;
  margin-top: 2px;
}
