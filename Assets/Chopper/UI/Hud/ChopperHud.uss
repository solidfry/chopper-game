.hud {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
}

.hud-panels {
  padding: 32px;
  justify-content: flex-end;
}

.hud--hidden {
  opacity: 0;
}

/* Match info, top of the screen */
.hud-match {
  padding: 32px;
}

.hud-match__top {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.hud-match__scores {
  width: 360px;
}

.hud-match__score {
  font-size: 24px;
  color: var(--chopper-green);
  padding: 0;
}

.hud-match__leader {
  font-size: 14px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-match__timer {
  font-size: 32px;
  color: var(--chopper-green);
  padding: 4px 16px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
  text-shadow: 0 0 6px rgba(57, 255, 136, 0.35);
}

.hud-match__feed {
  width: 360px;
  font-size: 16px;
  color: var(--chopper-text);
  -unity-text-align: upper-right;
  padding: 0;
}

.hud-match__banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  font-size: 72px;
  color: var(--chopper-green);
  -unity-text-align: middle-center;
  text-shadow: 0 0 12px rgba(57, 255, 136, 0.5);
}

.hud-match__banner--hidden {
  display: none;
}

/* Out of bounds warning, upper middle */
.hud-warning {
  position: absolute;
  left: 0;
  right: 0;
  top: 24%;
  align-items: center;
}

.hud-warning--hidden {
  display: none;
}

.hud-warning__text {
  font-size: 28px;
  color: var(--chopper-red);
  padding: 6px 18px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-red);
  text-shadow: 0 0 8px rgba(255, 64, 64, 0.4);
}

/* Speed and altitude, bottom left */
.hud-readouts {
  flex-direction: row;
}

.hud-readout {
  flex-direction: row;
  align-items: flex-end;
  min-width: 190px;
  margin-right: 16px;
  padding: 6px 12px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-left-width: 3px;
  border-left-color: var(--chopper-green);
  border-radius: var(--chopper-radius);
}

.hud-readout__label {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-right: 8px;
  margin-bottom: 6px;
  padding: 0;
}

.hud-readout__value {
  font-size: 40px;
  color: var(--chopper-green);
  -unity-text-align: lower-right;
  flex-grow: 1;
  padding: 0;
  margin: 0;
  /* Neon glow without post-processing */
  text-shadow: 0 0 6px rgba(57, 255, 136, 0.35);
}

.hud-readout__unit {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-left: 6px;
  margin-bottom: 6px;
  padding: 0;
}

/* Health turns red when low */
.hud-readout--low {
  border-left-color: var(--chopper-red);
}

.hud-readout--low .hud-readout__value {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 64, 64, 0.35);
}

/* Gun reticle. Left/top are set from code (where the gun points); translate centres it on that point. */
.hud-aim {
  position: absolute;
  width: 28px;
  height: 28px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  border-color: var(--chopper-green-dim);
  border-radius: 14px;
}

.hud-aim--hidden {
  display: none;
}

.hud-aim__dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--chopper-green);
}

/* Hit marker: a diamond around the reticle, shown only on a server hit confirm */
.hud-aim__hit {
  position: absolute;
  width: 34px;
  height: 34px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-text);
  opacity: 0;
}

.hud-aim--hit .hud-aim__hit {
  opacity: 1;
}

.hud-aim--kill .hud-aim__hit {
  opacity: 1;
  border-color: var(--chopper-red);
  scale: 1.4 1.4;
}

/* Damage direction: a ring round the screen centre, rotated from code; the arc points at the attacker */
.hud-damage-layer {
  align-items: center;
  justify-content: center;
}

.hud-damage {
  width: 260px;
  height: 260px;
  align-items: center;
  transition-property: opacity;
  transition-duration: 0.3s;
}

.hud-damage--hidden {
  opacity: 0;
}

.hud-damage__arc {
  width: 90px;
  height: 6px;
  border-radius: 3px;
  background-color: var(--chopper-red);
}

/* Dash charge, under the readouts */
.hud-dash {
  flex-direction: row;
  align-items: center;
  width: 396px;
  margin-top: 10px;
}

.hud-dash__label {
  font-size: 14px;
  color: var(--chopper-amber);
  width: 54px;
  padding: 0;
}

.hud-dash--ready .hud-dash__label {
  color: var(--chopper-green);
}

.hud-dash__bar {
  flex-grow: 1;
  margin: 0;
}

.hud-dash__bar .unity-progress-bar__background {
  height: 8px;
  min-height: 8px;
  background-color: var(--chopper-green-faint);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

.hud-dash__bar .unity-progress-bar__progress {
  background-color: var(--chopper-amber);
  border-radius: 0;
}

.hud-dash--ready .hud-dash__bar .unity-progress-bar__progress {
  background-color: var(--chopper-green);
}

.hud-dash__bar .unity-progress-bar__title-container {
  display: none;
}
