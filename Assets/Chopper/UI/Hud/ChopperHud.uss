.hud {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
}

/* Flight frame, centre of the view */
.hud-frame-layer {
  align-items: center;
  justify-content: center;
}

.hud-frame {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.hud-frame__ring {
  width: 400px;
  height: 400px;
  border-radius: 200px;
  border-width: 1px;
  border-color: var(--chopper-green-faint);
  align-items: center;
  justify-content: center;
}

.hud-frame__horizon {
  flex-direction: row;
  align-items: center;
  width: 320px;
}

.hud-frame__horizon-line {
  flex-grow: 1;
  height: 2px;
  background-color: var(--chopper-green-dim);
}

.hud-frame__horizon-gap {
  width: 80px;
}

.hud-frame__side {
  width: 220px;
}

.hud-frame__side--left {
  align-items: flex-end;
  padding-right: 24px;
}

.hud-frame__side--right {
  align-items: flex-start;
  padding-left: 24px;
}

/* Hull readout: beside the low end of the hull arc, clear of the chopper */
.hud-frame__hull {
  position: absolute;
  bottom: 20px;
  left: 50%;
  translate: 212px 0;
  min-width: 120px;
}

/* Field repair line, just above the hull readout */
.hud-repair {
  position: absolute;
  bottom: 74px;
  left: 50%;
  translate: 212px 0;
  font-size: 13px;
  letter-spacing: 3px;
  padding: 2px 8px;
  color: var(--chopper-green-dim);
  border-width: 0;
  transition-property: opacity, translate;
  transition-duration: 0.15s;
}

.hud-repair--hidden {
  opacity: 0;
  translate: 200px 0;
}

.hud-repair--active {
  color: var(--chopper-cyan);
  background-color: rgba(0, 40, 48, 0.6);
  border-left-width: 2px;
  border-color: var(--chopper-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
}

.hud-repair--locked {
  color: var(--chopper-yellow);
  background-color: rgba(48, 40, 0, 0.6);
  border-left-width: 2px;
  border-color: var(--chopper-yellow);
}

/* Lock after damage: fills along the bottom of the line until repair is ready */
.hud-repair__bar {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 3px;
  width: 0;
  display: none;
  background-color: var(--chopper-yellow);
}

.hud-repair--locked .hud-repair__bar {
  display: flex;
}

/* While repairing the hull arc and readout run cyan (more specific than the low-health red) */
.hud-arc.hud-hull-arc.hud-arc--repairing {
  --arc-fill: var(--chopper-cyan);
  --arc-track: rgba(0, 240, 255, 0.14);
}

.hud-readout.hud-readout--repairing {
  border-color: var(--chopper-cyan);
}

.hud-readout.hud-readout--repairing .hud-readout__value {
  color: var(--chopper-cyan);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
}

.hud--hidden {
  opacity: 0;
}

/* Match info, top of the screen */
.hud-match {
  padding: 32px;
}

.hud-match__top {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.hud-match__scores {
  width: 360px;
}

.hud-match__score {
  font-size: 24px;
  color: var(--chopper-green);
  padding: 0;
}

.hud-match__pilot {
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--chopper-yellow);
  padding: 0;
}

.hud-match__leader {
  font-size: 14px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-match__timer {
  font-size: 32px;
  color: var(--chopper-green);
  padding: 4px 16px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

.hud-match__feed {
  width: 360px;
  font-size: 16px;
  color: var(--chopper-text);
  -unity-text-align: upper-right;
  padding: 0;
}

.hud-match__banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  font-size: 72px;
  color: var(--chopper-green);
  -unity-text-align: middle-center;
  text-shadow: 0 0 12px rgba(0, 255, 148, 0.5);
}

.hud-match__banner--hidden {
  display: none;
}

/* Results: the banner moves up over the scoreboard */
.hud-match--results .hud-match__banner {
  top: 12%;
  font-size: 56px;
}

/* Scoreboard: centre of the view, hold Tab / gamepad View */
.hud-scoreboard {
  position: absolute;
  left: 0;
  right: 0;
  top: 24%;
  align-items: center;
  transition-property: opacity, translate;
  transition-duration: 0.12s;
}

.hud-scoreboard--hidden {
  opacity: 0;
  translate: 0 -8px;
}

.hud-scoreboard__head {
  width: 720px;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  padding: 6px 14px;
  border-bottom-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
}

.hud-scoreboard__title {
  font-size: 18px;
  letter-spacing: 4px;
  color: var(--chopper-green);
  padding: 0;
}

.hud-scoreboard__timer {
  font-size: 18px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-scoreboard__rows {
  width: 720px;
  background-color: var(--chopper-panel);
}

.hud-scoreboard__row {
  width: 720px;
  height: 34px;
  flex-direction: row;
  align-items: center;
  padding: 0 14px;
  border-left-width: 3px;
  border-color: rgba(0, 0, 0, 0);
}

.hud-scoreboard__row > Label {
  font-size: 17px;
  color: var(--chopper-text);
  padding: 0;
  -unity-text-align: middle-left;
}

.hud-scoreboard__row--columns > Label {
  font-size: 12px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
}

.hud-scoreboard__row--odd {
  background-color: rgba(0, 255, 148, 0.04);
}

/* Own row: yellow, with a bar on the left */
.hud-scoreboard__row--local {
  border-color: var(--chopper-yellow);
  background-color: rgba(255, 214, 0, 0.08);
}

.hud-scoreboard__row--local > Label {
  color: var(--chopper-yellow);
}

/* The leader's place number */
.hud-scoreboard__row--first .hud-scoreboard__place {
  color: var(--chopper-green);
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.45);
}

.hud-scoreboard__place {
  width: 44px;
}

.hud-scoreboard__name {
  flex-grow: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hud-scoreboard__chassis {
  width: 160px;
}

.hud-scoreboard__row > .hud-scoreboard__chassis {
  color: var(--chopper-green-dim);
}

.hud-scoreboard__number {
  width: 64px;
}

.hud-scoreboard__row > .hud-scoreboard__number {
  -unity-text-align: middle-right;
}

/* Out of bounds warning, upper middle */
.hud-warning {
  position: absolute;
  left: 0;
  right: 0;
  top: 24%;
  align-items: center;
}

.hud-warning--hidden {
  display: none;
}

.hud-warning__text {
  font-size: 28px;
  color: var(--chopper-red);
  padding: 6px 18px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-red);
  text-shadow: 0 0 8px rgba(255, 66, 70, 0.4);
}

/* Readout panels (speed, altitude, hull) */
/* Readouts: style guide card (dark fill, 1px accent border, accent value) */
.hud-readout {
  flex-direction: row;
  align-items: flex-end;
  min-width: 170px;
  margin-bottom: 10px;
  padding: 4px 12px 4px 10px;
  background-color: rgba(8, 27, 10, 0.6);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
}

.hud-readout__label {
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--chopper-green-dim);
  margin-right: 8px;
  margin-bottom: 6px;
  padding: 0;
}

.hud-readout__value {
  font-size: 32px;
  color: var(--chopper-green);
  -unity-text-align: lower-right;
  flex-grow: 1;
  padding: 0;
  margin: 0;
  /* Neon glow without post-processing */
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

.hud-readout__unit {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-left: 6px;
  margin-bottom: 6px;
  padding: 0;
}

/* Health turns red when low */
.hud-readout--low {
  border-color: var(--chopper-red);
  background-color: rgba(42, 26, 26, 0.7);
}

.hud-readout--low .hud-readout__value {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.35);
}

/* Gun reticle. Left/top are set from code (where the gun points); translate centres it on that point. */
.hud-aim {
  position: absolute;
  width: 28px;
  height: 28px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  border-color: var(--chopper-green-dim);
  border-radius: 14px;
}

.hud-aim--hidden {
  display: none;
}

.hud-aim__dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--chopper-green);
}

/* Hit marker: a diamond around the reticle, shown only on a server hit confirm */
.hud-aim__hit {
  position: absolute;
  width: 34px;
  height: 34px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-text);
  opacity: 0;
}

.hud-aim--hit .hud-aim__hit {
  opacity: 1;
}

.hud-aim--kill .hud-aim__hit {
  opacity: 1;
  border-color: var(--chopper-red);
  scale: 1.4 1.4;
}

/* Damage direction: a ring round the screen centre, rotated from code; the arc points at the attacker */
.hud-damage-layer {
  align-items: center;
  justify-content: center;
}

.hud-damage {
  width: 260px;
  height: 260px;
  align-items: center;
  transition-property: opacity;
  transition-duration: 0.3s;
}

.hud-damage--hidden {
  opacity: 0;
}

.hud-damage__arc {
  width: 90px;
  height: 6px;
  border-radius: 3px;
  background-color: var(--chopper-red);
}

/* Boost tank and hull: segmented arcs just outside the flight ring (ArcGauge). Colours are USS custom properties. */
.hud-arc {
  position: absolute;
  left: -18px;
  top: -18px;
  right: -18px;
  bottom: -18px;
  --arc-fill: rgba(0, 255, 148, 0.9);
  --arc-track: rgba(0, 255, 148, 0.12);
}

/* Not enough to start a boost: yellow (caution) */
.hud-boost {
  --arc-fill: var(--chopper-yellow);
  --arc-track: rgba(255, 223, 107, 0.12);
}

.hud-boost--ready {
  --arc-fill: var(--chopper-cyan);
  --arc-track: rgba(0, 240, 255, 0.12);
}

.hud--boosting .hud-boost {
  --arc-fill: var(--chopper-pink);
  --arc-track: rgba(255, 66, 137, 0.15);
}

/* Own class: the readout's low class also sets a dark background, which filled the arc's whole square. */
.hud-hull-arc.hud-arc--low {
  --arc-fill: var(--chopper-red);
  --arc-track: rgba(255, 66, 70, 0.15);
}

/* Gun heat: bottom arc. Yellow while it heats, red when the gun is locked out. */
.hud-heat-arc {
  --arc-fill: var(--chopper-yellow);
  --arc-track: rgba(255, 223, 107, 0.12);
}

.hud-heat-arc.hud-arc--low {
  --arc-fill: var(--chopper-red);
  --arc-track: rgba(255, 66, 70, 0.15);
}

.hud-heat-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -46px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
  -unity-text-align: middle-center;
  padding: 0;
}

.hud-heat-label--hot {
  font-size: 16px;
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.5);
}

/* No gun, or a gun with no heat limit */
.hud-heat--none {
  display: none;
}

.hud-arc__label {
  position: absolute;
  bottom: 52px;
  font-size: 11px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-arc__label--left {
  left: -44px;
}

/* Boost (pink): the flight ring runs hot, the speed readout grows and turns pink, the tag slams in. */
.hud-frame__ring {
  transition-property: border-color, scale;
  transition-duration: 0.15s;
}

.hud--boosting .hud-frame__ring {
  border-color: rgba(255, 66, 137, 0.45);
  scale: 1.04 1.04;
}

.hud-boost-tag {
  font-size: 15px;
  letter-spacing: 4px;
  color: var(--chopper-pink);
  padding: 0 0 4px 2px;
  opacity: 0;
  translate: -24px 0;
  text-shadow: 0 0 8px rgba(255, 66, 137, 0.8);
  transition-property: opacity, translate;
  transition-duration: 0.12s;
  transition-timing-function: ease-out-back;
}

.hud--boosting .hud-boost-tag {
  opacity: 1;
  translate: 0 0;
}

.hud-readout--speed {
  transform-origin: left bottom;
  transition-property: scale, border-color, background-color;
  transition-duration: 0.15s;
  transition-timing-function: ease-out-back;
}

.hud--boosting .hud-readout--speed {
  scale: 1.18 1.18;
  border-color: var(--chopper-pink);
  background-color: rgba(37, 26, 36, 0.7);
}

.hud-readout--speed .hud-readout__value {
  transition-property: color;
  transition-duration: 0.15s;
}

.hud--boosting .hud-readout--speed .hud-readout__value {
  color: var(--chopper-pink);
  text-shadow: 0 0 10px rgba(255, 66, 137, 0.7);
}

/* Seeker lock brackets. Size and position are set from code; yellow while building, red when locked. */
.hud-lock {
  position: absolute;
  translate: -50% -50%;
  border-width: 2px;
  border-color: var(--chopper-yellow);
  align-items: center;
  justify-content: flex-end;
}

.hud-lock--hidden {
  display: none;
}

.hud-lock--locked {
  border-color: var(--chopper-red);
  border-width: 3px;
}

.hud-lock__label {
  position: absolute;
  bottom: -26px;
  font-size: 14px;
  color: var(--chopper-yellow);
  padding: 0;
  opacity: 0;
}

.hud-lock--locked .hud-lock__label {
  color: var(--chopper-red);
  opacity: 1;
}

/* Threat warnings */
.hud-threats {
  position: absolute;
  left: 0;
  right: 0;
  top: 17%;
  align-items: center;
}

.hud-threat {
  font-size: 30px;
  padding: 4px 18px;
  margin-bottom: 6px;
  background-color: var(--chopper-panel);
  border-width: 2px;
  -unity-font-style: bold;
}

.hud-threat--missile {
  color: var(--chopper-red);
  border-color: var(--chopper-red);
  text-shadow: 0 0 10px rgba(255, 66, 70, 0.6);
}

.hud-threat--lock {
  font-size: 22px;
  color: var(--chopper-yellow);
  border-color: var(--chopper-yellow);
}

.hud-threat--hidden {
  display: none;
}

/* Blink: dim on the off beat (toggled from the model) */
.hud-threats--dim .hud-threat {
  opacity: 0.25;
}

.hud-damage--missile .hud-damage__arc {
  width: 140px;
  height: 8px;
  background-color: var(--chopper-red);
}

/* Selected pylon weapon and flares, left of the ring */
.hud-pylon {
  margin-top: 10px;
  font-size: 16px;
  color: var(--chopper-green);
  padding: 0;
  -unity-text-align: middle-right;
}

.hud-pylon--needs-lock {
  color: var(--chopper-yellow);
}

.hud-pylon-ammo {
  font-size: 24px;
  color: var(--chopper-green);
  padding: 0;
  -unity-text-align: middle-right;
  text-shadow: 0 0 6px rgba(0, 255, 148, 0.35);
}

.hud-pylon-ammo--empty {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 66, 70, 0.5);
}

/* Magazine refill. Width of the fill is set from code. Cyan like the boost tank: it is a charge that fills up. */
.hud-reload {
  width: 110px;
  height: 5px;
  margin-top: 3px;
  flex-direction: row;
  justify-content: flex-end;
  background-color: rgba(0, 240, 255, 0.14);
}

.hud-reload--small {
  width: 70px;
  height: 4px;
}

.hud-reload--hidden {
  display: none;
}

.hud-reload__fill {
  height: 100%;
  background-color: var(--chopper-cyan);
}

.hud-flares {
  margin-top: 6px;
  font-size: 15px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-flares--ready {
  color: var(--chopper-green);
}

/* World markers (WorldMarkerView). Left/top are set from code; translate centres the marker on that point. */
.hud-marker {
  position: absolute;
  translate: -50% -50%;
  align-items: center;
}

.hud-marker--hidden {
  display: none;
}

.hud-marker__icon {
  width: 14px;
  height: 14px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-red);
}

.hud-marker--ground .hud-marker__icon {
  rotate: 0deg;
  border-color: var(--chopper-yellow);
}

.hud-marker--locked .hud-marker__icon {
  background-color: var(--chopper-red);
}

.hud-marker__distance {
  position: absolute;
  top: 18px;
  font-size: 12px;
  color: var(--chopper-text);
  padding: 0;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.hud-marker__health {
  position: absolute;
  top: -10px;
  width: 30px;
  height: 3px;
  background-color: var(--chopper-green-faint);
}

.hud-marker__health-fill {
  height: 100%;
  background-color: var(--chopper-red);
}

.hud-marker--no-health .hud-marker__health,
.hud-marker--offscreen .hud-marker__health {
  display: none;
}

/* Off screen: an arrow on the screen edge points at the target (rotated from code). */
.hud-marker__arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left-width: 7px;
  border-right-width: 7px;
  border-bottom-width: 12px;
  border-left-color: rgba(0, 0, 0, 0);
  border-right-color: rgba(0, 0, 0, 0);
  border-bottom-color: var(--chopper-red);
  display: none;
}

.hud-marker--offscreen .hud-marker__icon {
  display: none;
}

.hud-marker--offscreen .hud-marker__arrow {
  display: flex;
}

.hud-marker--ground .hud-marker__arrow {
  border-bottom-color: var(--chopper-yellow);
}

/* Rocket lead indicator */
.hud-lead {
  position: absolute;
  width: 18px;
  height: 18px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-color: var(--chopper-green);
  border-radius: 9px;
}

.hud-lead--hidden {
  display: none;
}

.hud-lead__dot {
  width: 4px;
  height: 4px;
  background-color: var(--chopper-green);
}

/* Pilot ability line (under flares): dim while cooling down, bright when ready, pink while on */
.hud-ability {
  font-size: 13px;
  letter-spacing: 3px;
  padding: 2px 8px;
  margin-top: 4px;
  color: var(--chopper-green-dim);
  transition-property: opacity, scale;
  transition-duration: 0.15s;
}

.hud-ability--hidden {
  display: none;
}

.hud-ability--ready {
  color: var(--chopper-yellow);
  border-right-width: 2px;
  border-color: var(--chopper-yellow);
  background-color: rgba(48, 40, 0, 0.5);
}

.hud-ability--active {
  color: var(--chopper-pink);
  border-right-width: 2px;
  border-color: var(--chopper-pink);
  background-color: rgba(60, 10, 30, 0.6);
  text-shadow: 0 0 8px rgba(255, 66, 137, 0.7);
  scale: 1.08 1.08;
}

.hud-threat--jam {
  color: var(--chopper-cyan);
  border-color: var(--chopper-cyan);
}

/* Ping (pilot OVERWATCH): every enemy, cyan */
.hud-marker--pinged .hud-marker__icon {
  background-color: var(--chopper-cyan);
}

.hud-marker--pinged.hud-marker--locked .hud-marker__icon {
  background-color: var(--chopper-red);
}
