.hud {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.hud-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
}

/* Flight frame, centre of the view */
.hud-frame-layer {
  align-items: center;
  justify-content: center;
}

.hud-frame {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.hud-frame__ring {
  width: 400px;
  height: 400px;
  border-radius: 200px;
  border-width: 1px;
  border-color: var(--chopper-green-faint);
  align-items: center;
  justify-content: center;
}

.hud-frame__horizon {
  flex-direction: row;
  align-items: center;
  width: 320px;
}

.hud-frame__horizon-line {
  flex-grow: 1;
  height: 2px;
  background-color: var(--chopper-green-dim);
}

.hud-frame__horizon-gap {
  width: 80px;
}

.hud-frame__side {
  width: 220px;
}

.hud-frame__side--left {
  align-items: flex-end;
  padding-right: 24px;
}

.hud-frame__side--right {
  align-items: flex-start;
  padding-left: 24px;
}

.hud-frame__hull {
  position: absolute;
  bottom: -64px;
  left: 50%;
  translate: -50% 0;
}

.hud--hidden {
  opacity: 0;
}

/* Match info, top of the screen */
.hud-match {
  padding: 32px;
}

.hud-match__top {
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}

.hud-match__scores {
  width: 360px;
}

.hud-match__score {
  font-size: 24px;
  color: var(--chopper-green);
  padding: 0;
}

.hud-match__leader {
  font-size: 14px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-match__timer {
  font-size: 32px;
  color: var(--chopper-green);
  padding: 4px 16px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: var(--chopper-radius);
  text-shadow: 0 0 6px rgba(57, 255, 136, 0.35);
}

.hud-match__feed {
  width: 360px;
  font-size: 16px;
  color: var(--chopper-text);
  -unity-text-align: upper-right;
  padding: 0;
}

.hud-match__banner {
  position: absolute;
  left: 0;
  right: 0;
  top: 38%;
  font-size: 72px;
  color: var(--chopper-green);
  -unity-text-align: middle-center;
  text-shadow: 0 0 12px rgba(57, 255, 136, 0.5);
}

.hud-match__banner--hidden {
  display: none;
}

/* Out of bounds warning, upper middle */
.hud-warning {
  position: absolute;
  left: 0;
  right: 0;
  top: 24%;
  align-items: center;
}

.hud-warning--hidden {
  display: none;
}

.hud-warning__text {
  font-size: 28px;
  color: var(--chopper-red);
  padding: 6px 18px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-red);
  text-shadow: 0 0 8px rgba(255, 64, 64, 0.4);
}

/* Readout panels (speed, altitude, hull) */
.hud-readout {
  flex-direction: row;
  align-items: flex-end;
  min-width: 170px;
  margin-bottom: 10px;
  padding: 4px 10px;
  background-color: var(--chopper-panel);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-left-width: 3px;
  border-left-color: var(--chopper-green);
  border-radius: var(--chopper-radius);
}

.hud-readout__label {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-right: 8px;
  margin-bottom: 6px;
  padding: 0;
}

.hud-readout__value {
  font-size: 32px;
  color: var(--chopper-green);
  -unity-text-align: lower-right;
  flex-grow: 1;
  padding: 0;
  margin: 0;
  /* Neon glow without post-processing */
  text-shadow: 0 0 6px rgba(57, 255, 136, 0.35);
}

.hud-readout__unit {
  font-size: 14px;
  color: var(--chopper-green-dim);
  margin-left: 6px;
  margin-bottom: 6px;
  padding: 0;
}

/* Health turns red when low */
.hud-readout--low {
  border-left-color: var(--chopper-red);
}

.hud-readout--low .hud-readout__value {
  color: var(--chopper-red);
  text-shadow: 0 0 6px rgba(255, 64, 64, 0.35);
}

/* Gun reticle. Left/top are set from code (where the gun points); translate centres it on that point. */
.hud-aim {
  position: absolute;
  width: 28px;
  height: 28px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  border-color: var(--chopper-green-dim);
  border-radius: 14px;
}

.hud-aim--hidden {
  display: none;
}

.hud-aim__dot {
  width: 4px;
  height: 4px;
  border-radius: 2px;
  background-color: var(--chopper-green);
}

/* Hit marker: a diamond around the reticle, shown only on a server hit confirm */
.hud-aim__hit {
  position: absolute;
  width: 34px;
  height: 34px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-text);
  opacity: 0;
}

.hud-aim--hit .hud-aim__hit {
  opacity: 1;
}

.hud-aim--kill .hud-aim__hit {
  opacity: 1;
  border-color: var(--chopper-red);
  scale: 1.4 1.4;
}

/* Damage direction: a ring round the screen centre, rotated from code; the arc points at the attacker */
.hud-damage-layer {
  align-items: center;
  justify-content: center;
}

.hud-damage {
  width: 260px;
  height: 260px;
  align-items: center;
  transition-property: opacity;
  transition-duration: 0.3s;
}

.hud-damage--hidden {
  opacity: 0;
}

.hud-damage__arc {
  width: 90px;
  height: 6px;
  border-radius: 3px;
  background-color: var(--chopper-red);
}

/* Dash charge, under the readouts */
.hud-dash {
  flex-direction: row;
  align-items: center;
}

.hud-dash__label {
  font-size: 14px;
  color: var(--chopper-amber);
  width: 54px;
  padding: 0;
}

.hud-dash--ready .hud-dash__label {
  color: var(--chopper-green);
}

.hud-dash__bar {
  width: 120px;
  margin: 0;
}

.hud-dash__bar .unity-progress-bar__background {
  height: 8px;
  min-height: 8px;
  background-color: var(--chopper-green-faint);
  border-width: var(--chopper-border-width);
  border-color: var(--chopper-green-dim);
  border-radius: 0;
}

.hud-dash__bar .unity-progress-bar__progress {
  background-color: var(--chopper-amber);
  border-radius: 0;
}

.hud-dash--ready .hud-dash__bar .unity-progress-bar__progress {
  background-color: var(--chopper-green);
}

.hud-dash__bar .unity-progress-bar__title-container {
  display: none;
}

/* Seeker lock brackets. Size and position are set from code; amber while building, red when locked. */
.hud-lock {
  position: absolute;
  translate: -50% -50%;
  border-width: 2px;
  border-color: var(--chopper-amber);
  align-items: center;
  justify-content: flex-end;
}

.hud-lock--hidden {
  display: none;
}

.hud-lock--locked {
  border-color: var(--chopper-red);
  border-width: 3px;
}

.hud-lock__label {
  position: absolute;
  bottom: -26px;
  font-size: 14px;
  color: var(--chopper-amber);
  padding: 0;
  opacity: 0;
}

.hud-lock--locked .hud-lock__label {
  color: var(--chopper-red);
  opacity: 1;
}

/* Threat warnings */
.hud-threats {
  position: absolute;
  left: 0;
  right: 0;
  top: 17%;
  align-items: center;
}

.hud-threat {
  font-size: 30px;
  padding: 4px 18px;
  margin-bottom: 6px;
  background-color: var(--chopper-panel);
  border-width: 2px;
  -unity-font-style: bold;
}

.hud-threat--missile {
  color: var(--chopper-red);
  border-color: var(--chopper-red);
  text-shadow: 0 0 10px rgba(255, 64, 64, 0.6);
}

.hud-threat--lock {
  font-size: 22px;
  color: var(--chopper-amber);
  border-color: var(--chopper-amber);
}

.hud-threat--hidden {
  display: none;
}

/* Blink: dim on the off beat (toggled from the model) */
.hud-threats--dim .hud-threat {
  opacity: 0.25;
}

.hud-damage--missile .hud-damage__arc {
  width: 140px;
  height: 8px;
  background-color: var(--chopper-red);
}

/* Selected pylon weapon and flares, left of the ring */
.hud-pylon {
  margin-top: 10px;
  font-size: 16px;
  color: var(--chopper-green);
  padding: 0;
  -unity-text-align: middle-right;
}

.hud-pylon--needs-lock {
  color: var(--chopper-amber);
}

.hud-flares {
  margin-top: 4px;
  font-size: 13px;
  color: var(--chopper-green-dim);
  padding: 0;
}

.hud-flares--ready {
  color: var(--chopper-green);
}

/* World markers (WorldMarkerView). Left/top are set from code; translate centres the marker on that point. */
.hud-marker {
  position: absolute;
  translate: -50% -50%;
  align-items: center;
}

.hud-marker--hidden {
  display: none;
}

.hud-marker__icon {
  width: 14px;
  height: 14px;
  rotate: 45deg;
  border-width: 2px;
  border-color: var(--chopper-red);
}

.hud-marker--ground .hud-marker__icon {
  rotate: 0deg;
  border-color: var(--chopper-amber);
}

.hud-marker--locked .hud-marker__icon {
  background-color: var(--chopper-red);
}

.hud-marker__distance {
  position: absolute;
  top: 18px;
  font-size: 12px;
  color: var(--chopper-text);
  padding: 0;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.hud-marker__health {
  position: absolute;
  top: -10px;
  width: 30px;
  height: 3px;
  background-color: var(--chopper-green-faint);
}

.hud-marker__health-fill {
  height: 100%;
  background-color: var(--chopper-red);
}

.hud-marker--no-health .hud-marker__health,
.hud-marker--offscreen .hud-marker__health {
  display: none;
}

/* Off screen: an arrow on the screen edge points at the target (rotated from code). */
.hud-marker__arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left-width: 7px;
  border-right-width: 7px;
  border-bottom-width: 12px;
  border-left-color: rgba(0, 0, 0, 0);
  border-right-color: rgba(0, 0, 0, 0);
  border-bottom-color: var(--chopper-red);
  display: none;
}

.hud-marker--offscreen .hud-marker__icon {
  display: none;
}

.hud-marker--offscreen .hud-marker__arrow {
  display: flex;
}

.hud-marker--ground .hud-marker__arrow {
  border-bottom-color: var(--chopper-amber);
}

/* Rocket lead indicator */
.hud-lead {
  position: absolute;
  width: 18px;
  height: 18px;
  translate: -50% -50%;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-color: var(--chopper-green);
  border-radius: 9px;
}

.hud-lead--hidden {
  display: none;
}

.hud-lead__dot {
  width: 4px;
  height: 4px;
  background-color: var(--chopper-green);
}
