<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
  <Style src="SceneTransition.uss" />
  <!-- Scene change overlay (SceneTransitionView): the block wipe, and the destination over it while covered.
       Type (style guide): destination in Karnivore Dot (display), values in Bold, labels in Lite, the tip in Chakra Petch. -->
  <ui:VisualElement name="transition" class="transition transition--hidden" picking-mode="Ignore">
    <Chopper.UI.Transitions.DigitalWipe name="wipe" class="transition__wipe" />
    <ui:VisualElement name="info" class="transition__info" picking-mode="Ignore">
      <ui:Label name="status" text="LINKING" class="transition__status" />
      <ui:Label name="label" text="" class="transition__label chopper-deco-dot" />
      <ui:VisualElement class="transition__rule" picking-mode="Ignore" />
    </ui:VisualElement>
    <!-- Match briefing (MatchBriefing): a quiet terminal read-out under the destination; the values type in.
         Tagline and rules are left out on purpose (owner, 26 Nov: less text, subtle). -->
    <ui:VisualElement name="briefing" class="briefing briefing--hidden" picking-mode="Ignore">
      <ui:VisualElement class="briefing__rows" picking-mode="Ignore">
        <ui:VisualElement class="briefing__row" picking-mode="Ignore">
          <ui:Label text="MODE" class="briefing__key" picking-mode="Ignore" />
          <ui:Label name="briefing-mode" class="briefing__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="briefing__row" picking-mode="Ignore">
          <ui:Label text="AREA" class="briefing__key" picking-mode="Ignore" />
          <ui:Label name="briefing-map" class="briefing__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="briefing__row" picking-mode="Ignore">
          <ui:Label text="COND" class="briefing__key" picking-mode="Ignore" />
          <ui:Label name="briefing-conditions" class="briefing__value briefing__value--accent" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="briefing__row" picking-mode="Ignore">
          <ui:Label text="SLOTS" class="briefing__key" picking-mode="Ignore" />
          <ui:Label name="briefing-players" class="briefing__value" picking-mode="Ignore" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:Label name="briefing-tip" class="briefing__tip chopper-body" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Label name="code" text="" class="transition__code chopper-deco-dot" />
  </ui:VisualElement>
</ui:UXML>
