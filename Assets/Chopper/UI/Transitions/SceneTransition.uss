/* Scene change overlay: drawn over every panel (own panel settings, high sort order). */
.transition {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition--hidden {
  display: none;
}

.transition__wipe {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition__info {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  align-items: center;
}

/* The terminal log, bottom left (owner, 26 Nov): one column, left aligned, small and calm. */
.terminal {
  position: absolute;
  left: 64px;
  bottom: 72px;
  width: 760px;
  max-width: 70%;
}

.terminal__block {
  flex-direction: column;
}

.briefing--hidden {
  display: none;
}

.terminal__line {
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 6px;
}

.terminal__line--gap {
  margin-top: 14px;
}

.terminal__mark {
  width: 22px;
  font-size: 15px;
  padding: 0;
  -unity-text-align: upper-left;
}

.terminal__mark--prompt {
  color: var(--chopper-cyan);
  opacity: 0.6;
}

.terminal__mark--bullet {
  color: var(--chopper-green);
}

.terminal__mark--tip {
  color: var(--chopper-yellow);
  opacity: 0.7;
}

.terminal__prompt {
  font-size: 14px;
  letter-spacing: 2px;
  color: var(--chopper-cyan);
  opacity: 0.6;
  padding: 0;
}

.terminal__title,
.terminal__title.chopper-title {
  font-size: 18px;
  letter-spacing: 4px;
  color: var(--chopper-green);
  padding: 0;
  text-shadow: 0 0 10px rgba(0, 255, 148, 0.25);
}

/* Result lines under the bullet, indented with a hanging bar. */
.terminal__result {
  flex-direction: row;
  margin-left: 22px;
  padding-left: 14px;
  border-left-width: 1px;
  border-color: var(--chopper-green-dim);
  padding-top: 2px;
  padding-bottom: 2px;
}

.terminal__key {
  width: 70px;
  font-size: 13px;
  color: var(--chopper-text);
  opacity: 0.4;
  padding: 0;
}

.terminal__value {
  flex-grow: 1;
  font-size: 13px;
  letter-spacing: 1px;
  color: var(--chopper-text);
  opacity: 0.85;
  padding: 0;
}

.terminal__value--accent {
  color: var(--chopper-yellow);
}

.terminal__tip {
  flex-shrink: 1;
  flex-grow: 1;
  font-size: 13px;
  color: var(--chopper-text);
  opacity: 0.55;
  padding: 0;
  white-space: normal;
}

/* Link address, bottom right: faint decoration. */
.transition__code {
  position: absolute;
  right: 64px;
  bottom: 72px;
  font-size: 10px;
  color: var(--chopper-cyan);
  opacity: 0.3;
  padding: 0;
}

/* LCD panel (owner, 26 Nov): a subpixel grid tiled over the cover, a faint green backlight and a dark edge.
   Fades in with the text (SceneTransitionView sets its opacity). */
.transition__lcd {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0;
}

.transition__lcd-glow,
.transition__lcd-grid,
.transition__lcd-vignette {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition__lcd-glow {
  background-color: var(--chopper-green);
  opacity: 0.06;
}

.transition__lcd-grid {
  opacity: 0.7;
}

.transition__lcd-vignette {
  background-image: url("/Assets/Chopper/UI/Transitions/LcdVignette.png");
  -unity-background-scale-mode: stretch-to-fill;
  opacity: 1;
}
