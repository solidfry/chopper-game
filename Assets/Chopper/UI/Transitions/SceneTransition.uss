/* Scene change overlay: drawn over every panel (own panel settings, high sort order). */
.transition {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition--hidden {
  display: none;
}

.transition__wipe {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition__info {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  align-items: center;
}

.transition__status {
  font-size: 11px;
  letter-spacing: 8px;
  color: var(--chopper-cyan);
  opacity: 0.5;
  padding: 0;
  margin-bottom: 14px;
}

.transition__label,
.transition__label.chopper-deco-dot {
  /* Display name in Karnivore Dot (style guide), held back: subtle glow, wide tracking. */
  font-size: 46px;
  letter-spacing: 18px;
  opacity: 1;
  color: var(--chopper-green);
  padding: 0;
  text-shadow: 0 0 18px rgba(0, 255, 148, 0.3);
}

.transition__rule {
  width: 240px;
  height: 1px;
  margin-top: 22px;
  background-color: var(--chopper-green-dim);
  opacity: 0.6;
}

.transition__code {
  position: absolute;
  left: 56px;
  bottom: 44px;
  font-size: 10px;
  color: var(--chopper-cyan);
  opacity: 0.3;
  padding: 0;
}

/* With a briefing the destination sits a little higher. */
.transition__info--briefing {
  top: 34%;
}

/* Match briefing (SceneTransitionView): a small terminal read-out, key then value, under the destination. */
.briefing {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.briefing__rows {
  position: absolute;
  left: 0;
  right: 0;
  top: 52%;
  align-items: center;
}

.briefing--hidden {
  display: none;
}

.briefing__row {
  flex-direction: row;
  width: 360px;
  margin-bottom: 8px;
}

.briefing__key {
  width: 110px;
  font-size: 11px;
  letter-spacing: 6px;
  color: var(--chopper-cyan);
  opacity: 0.45;
  padding: 0;
  -unity-text-align: middle-left;
}

.briefing__value {
  flex-grow: 1;
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--chopper-green);
  opacity: 0.85;
  padding: 0;
  -unity-text-align: middle-left;
}

.briefing__value--accent {
  color: var(--chopper-yellow);
  opacity: 0.75;
}

/* The tip: one dim line near the bottom, as a terminal comment. */
.briefing__tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 44px;
  font-size: 13px;
  color: var(--chopper-text);
  opacity: 0.4;
  -unity-text-align: middle-center;
  white-space: normal;
  padding: 0 20%;
}
