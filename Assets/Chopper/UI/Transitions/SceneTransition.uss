/* Scene change overlay: drawn over every panel (own panel settings, high sort order). */
.transition {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition--hidden {
  display: none;
}

.transition__wipe {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.transition__info {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  align-items: center;
}

.transition__status {
  font-size: 14px;
  letter-spacing: 6px;
  color: var(--chopper-cyan);
  opacity: 0.7;
  padding: 0;
  margin-bottom: 10px;
}

.transition__label,
.transition__label.chopper-deco-dot {
  /* Display name in Karnivore Dot, as the page headings (style guide). */
  font-size: 60px;
  letter-spacing: 10px;
  opacity: 1;
  color: var(--chopper-green);
  padding: 0;
  text-shadow: 0 0 14px rgba(0, 255, 148, 0.55);
}

.transition__rule {
  width: 320px;
  height: 1px;
  margin-top: 10px;
  background-color: var(--chopper-green-dim);
}

.transition__code {
  position: absolute;
  left: 32px;
  bottom: 28px;
  font-size: 13px;
  color: var(--chopper-cyan);
  opacity: 0.45;
  padding: 0;
}

/* With a briefing the destination moves up to make room. */
.transition__info--briefing {
  top: 18%;
}

/* Match briefing (SceneTransitionView): two columns, a tip under them. */
.briefing {
  position: absolute;
  left: 0;
  right: 0;
  top: 34%;
  align-items: center;
}

.briefing--hidden {
  display: none;
}

.briefing__columns {
  flex-direction: row;
  width: 900px;
  max-width: 90%;
}

.briefing__column {
  flex-grow: 1;
  flex-basis: 0;
  padding: 0 24px;
}

.briefing__divider {
  width: 1px;
  background-color: var(--chopper-green-dim);
  opacity: 0.6;
}

.briefing__head {
  font-size: 13px;
  letter-spacing: 4px;
  color: var(--chopper-cyan);
  opacity: 0.75;
  padding: 0;
  margin-bottom: 8px;
}

.briefing__big {
  font-size: 30px;
  letter-spacing: 4px;
  color: var(--chopper-green);
  padding: 0;
  white-space: normal;
  text-shadow: 0 0 10px rgba(0, 255, 148, 0.4);
}

.briefing__line {
  font-size: 15px;
  letter-spacing: 3px;
  color: var(--chopper-green-dim);
  padding: 0;
  margin-top: 4px;
  white-space: normal;
}

.briefing__line--accent {
  color: var(--chopper-yellow);
}

.briefing__rules {
  font-size: 15px;
  letter-spacing: 2px;
  color: var(--chopper-green);
  padding: 0;
  margin-top: 14px;
  white-space: normal;
}

.briefing__tip-row {
  flex-direction: row;
  width: 900px;
  max-width: 90%;
  margin-top: 36px;
  padding: 12px 24px;
  /* A style-guide card: dark-pair fill, 1px accent border. */
  border-width: 1px;
  border-color: var(--chopper-green-dim);
  background-color: var(--chopper-panel);
}

.briefing__tip-head {
  font-size: 15px;
  letter-spacing: 3px;
  color: var(--chopper-yellow);
  padding: 0;
  margin-right: 12px;
}

.briefing__tip {
  flex-shrink: 1;
  flex-grow: 1;
  font-size: 17px;
  color: var(--chopper-text);
  padding: 0;
  white-space: normal;
}
