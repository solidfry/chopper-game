# Auto detect text files and perform LF normalization
* text=auto

# Unity writes its YAML files with LF. Keep them LF on checkout so git stops warning on every save.
*.unity          text eol=lf
*.prefab         text eol=lf
# *.asset is left on auto: terrain and lighting data .asset files are binary.
*.mat            text eol=lf
*.meta           text eol=lf
*.anim           text eol=lf
*.controller     text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.mask           text eol=lf
*.playable       text eol=lf
*.signal         text eol=lf
*.shadergraph    text eol=lf
*.shadersubgraph text eol=lf
*.vfx            text eol=lf
*.lighting       text eol=lf
*.preset         text eol=lf
*.spriteatlas    text eol=lf
*.terrainlayer   text eol=lf
*.mixer          text eol=lf
*.inputactions   text eol=lf
*.asmdef         text eol=lf
*.asmref         text eol=lf
*.uxml           text eol=lf
*.uss            text eol=lf
*.tss            text eol=lf
*.json           text eol=lf

# Binary assets: never diff or convert line endings.
*.blend    binary
*.obj      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.tga      binary
*.psd      binary
*.exr      binary
*.hdr      binary
*.tif      binary
*.wav      binary
*.mp3      binary
*.ogg      binary
*.ttf      binary
*.otf      binary
*.dll      binary
*.so       binary
*.bundle   binary
*.unitypackage binary
*.pdf      binary

# Generated models (Tools/PartForge) and previews.
*.fbx            binary
*.jpg            binary

# Docker files run on Linux: keep LF.
Tools/Edgegap/* text eol=lf
